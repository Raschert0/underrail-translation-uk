    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::You see a small bright flat-looking ripple in the otherwise three-dimensional space around you.::&lt;end&gt;</source>
        <target state="needs-translation">::Ви бачите невеликий яскравий плоский блиск у тривимірному просторі навколо вас.::&lt;end&gt;</target>
      </segment>
    </unit>
