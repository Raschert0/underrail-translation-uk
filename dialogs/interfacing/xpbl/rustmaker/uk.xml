  <file id="dialogs\interfacing\xpbl\rustmaker.txt" original="dialogs\interfacing\xpbl\rustmaker.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::This spear tip seems to have spent enough time lodged inside a sea wyrm to get infused with its rusting acid. The original shaft was destroyed during the attack, but you might be able to replace it with a new one.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a2" name="=&gt;a2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::[Mechanics] Repair the spear by attaching it to a new shaft.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You successfully attach the spear tip to a new shaft, taking care not to get in contact with the rusting acid or let it drip on any of your gear.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a4" name="=&gt;a4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave it be for now.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
