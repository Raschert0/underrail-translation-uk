<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\interfacing\xpbl\mu_ventilationunit.txt" original="dialogs\interfacing\xpbl\mu_ventilationunit.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::This ventilation unit's grill has been punctured, and the hole is more than large enough for you to go through. The fan inside has been motionless for decades, if not more, judging by its thick coating of green muck.::&lt;end&gt;</source>
        <target state="needs-translation">::Решітка цього вентиляційного блоку пробита, і отвір достатньо великий, щоб ви могли пройти. Вентилятор всередині не рухався десятиліттями, якщо не більше, судячи з товстого шару зеленої гнилі.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a2" name="=&gt;a2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Climb down the ventilation shaft.::&lt;end&gt;</source>
        <target state="needs-translation">::Спуститися у вентиляційний шахт.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a3" name="=&gt;a3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave.::&lt;end&gt;</source>
        <target state="needs-translation">::Залишити.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::This ventilation shaft leads only up.::&lt;end&gt;</source>
        <target state="needs-translation">::Цей вентиляційний шахт веде лише вгору.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a5" name="=&gt;a5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Climb up the ventilation shaft.::&lt;end&gt;</source>
        <target state="needs-translation">::Вилізти у вентиляційний шахт.::&lt;end&gt;</target>
      </segment>
    </unit>
