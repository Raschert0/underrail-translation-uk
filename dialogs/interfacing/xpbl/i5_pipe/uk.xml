        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Leave.::&lt;end&gt;</source>
        <target state="needs-translation">::Залиште.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::The pipe seems just wide enough for you to crawl through.::&lt;end&gt;</source>
        <target state="needs-translation">::Труба здається достатньо широкою, щоб ви могли проповзти через неї.::&lt;end&gt;</target>
      </segment>
    </unit>
