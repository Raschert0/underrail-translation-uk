  <file id="dialogs\interfacing\dc-pp_e_wall.txt" original="dialogs\interfacing\dc-pp_e_wall.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::This section of the wall seems climbable due to the extensive damage it has suffered. Perhaps you can reach the other side with some effort.::&lt;end&gt;</source>
        <target state="needs-translation">::Ця частина стіни здається зручною для підйому через значні пошкодження, яких вона зазнала. Можливо, ви зможете дістатися на інший бік, доклавши зусиль.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a2" name="=&gt;a2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::[Agility] Try to climb over.::&lt;end&gt;</source>
        <target state="needs-translation">::[Спритність] Спробуйте перелізти.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You manage to climb over the wall and reach the other side.::&lt;end&gt;</source>
        <target state="needs-translation">::Вам вдається перелізти через стіну і дістатися на інший бік.::&lt;end&gt;</target>
      </segment>
    </unit>
