  <file id="dialogs\interfacing\fls3_rock.txt" original="dialogs\interfacing\fls3_rock.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::The rocks pile up high, but not all the way to the cave ceiling. Perhaps you would be able to climb over.::&lt;end&gt;</source>
        <target state="needs-translation">::Скелі здіймаються високо, але не до самої стелі печери. Можливо, ти зможеш перелізти через них.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a2" name="=&gt;a2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::[Agility] Try to climb over.::&lt;end&gt;</source>
        <target state="needs-translation">::[Спритність] Спробуй перелізти.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::You manage to climb the rocks and reach the other side.::&lt;end&gt;</source>
        <target state="needs-translation">::Тобі вдається перелізти через скелі та дістатися на інший бік.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::You attempt to climb the rock pile, but it's just too steep.::&lt;end&gt;</source>
        <target state="needs-translation">::Ти намагаєшся перелізти через купу скель, але вона занадто крута.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a5" name="=&gt;a5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Leave.::&lt;end&gt;</source>
        <target state="needs-translation">::Залиш.::&lt;end&gt;</target>
      </segment>
