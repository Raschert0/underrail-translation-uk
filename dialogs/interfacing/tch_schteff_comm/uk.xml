<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\interfacing\tch_schteff_comm.txt" original="dialogs\interfacing\tch_schteff_comm.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I've got a good reading, $(#brother/sister). Return to the Institute. Out.&lt;end&gt;</source>
        <target state="needs-translation">У мене хороший сигнал, $(#брате/сестро). Повернись до Інституту. Кінець.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The signal is not as good as I had hoped. Head further to the east, $(#brother/sister); I think the signal will be better there. Over.&lt;end&gt;</source>
        <target state="needs-translation">Сигнал не такий хороший, як я сподівався. Рухайся далі на схід, $(#брате/сестро); думаю, там сигнал буде кращим. Кінець.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a4" name="=&gt;a4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Understood. Tchort guide you.&lt;end&gt;</source>
        <target state="needs-translation">Зрозумів. Тчорт нехай тебе веде.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tchort guide you. Out.&lt;end&gt;</source>
        <target state="needs-translation">Тчорт нехай тебе веде. Кінець.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a6" name="=&gt;a6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yeah, I got it.&lt;end&gt;</source>
        <target state="needs-translation">Так, я зрозумів.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The signal is extremely weak. Perhaps you should try going to the east, $(#brother/sister); I think the signal will be better there. Over.&lt;end&gt;</source>
        <target state="needs-translation">Сигнал надзвичайно слабкий. Можливо, тобі варто піти на схід, $(#брате/сестро); думаю, там сигнал буде кращим. Кінець.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>...weak... return... east - east... hear me...?&lt;end&gt;</source>
        <target state="needs-translation">...слабкий... повернись... схід - схід... чуєш мене...?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yes, the signal is much stronger. Head just a bit more south and the signal will be perfect! Over.&lt;end&gt;</source>
        <target state="needs-translation">Так, сигнал набагато сильніший. Підійди трохи південніше, і сигнал буде ідеальним! Кінець.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a11" name="=&gt;a11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Understood; I'm on it. Out.&lt;end&gt;</source>
        <target state="needs-translation">Зрозумів; я вже йду. Кінець.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>That is almost perfect, but there is just a hint of interference, $(#brother/sister). Just a bit to the west and it'll be one hundred percent perfect! Over.&lt;end&gt;</source>
        <target state="needs-translation">Майже ідеально, але є невеличне втручання, $(#брате/сестро). Просто трохи на захід, і все буде на сто відсотків ідеально! Прийнято.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The signal is perfect! Find a good spot to deploy it and head back. Remember, don't put it too near other electronics; also, do not place it inside anything made of metal. You can put it *on* something metal, though. I'm waiting for your return, $(#brother/sister). Out.&lt;end&gt;</source>
        <target state="needs-translation">Сигнал ідеальний! Знайдіть гарне місце для його розгортання і повертайтеся. Пам'ятайте, не ставте його надто близько до іншої електроніки; також не розміщуйте його всередині чогось металевого. Можете поставити його *на* щось металеве, хоча. Чекаю на ваше повернення, $(#брате/сестро). Кінець.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a14" name="=&gt;a14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::End Dialog::&lt;end&gt;</source>
        <target state="needs-translation">::Кінець діалогу::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The signal is a lot better here, but I am detecting some heavy interference. Try going a a bit to the south, $(#brother/sister). You are almost there. Over.&lt;end&gt;</source>
        <target state="needs-translation">Сигнал тут набагато кращий, але я виявляю сильні перешкоди. Спробуйте пройти трохи на південь, $(#брате/сестро). Ви майже там. Прийнято.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Head down to Harpocrates Station. Over.&lt;end&gt;</source>
        <target state="needs-translation">Спустіться до станції Гарпократес. Прийнято.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q17" name="=&gt;q17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I hear you loud and clear, $(context.player.Name). Head for Core City station in Upper Underrail. Over.&lt;end&gt;</source>
        <target state="needs-translation">Я чую вас чітко, $(context.player.Name). Рушайте до станції Core City у Верхньому Підземному Світі. Прийнято.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q18" name="=&gt;q18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You hear nothing but static.::&lt;end&gt;</source>
        <target state="needs-translation">::Ви чуєте лише статичні перешкоди.::&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
