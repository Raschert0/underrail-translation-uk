        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You turn off the monitor. Vlatko will be pleased.::&lt;end&gt;</source>
        <target state="new" />
