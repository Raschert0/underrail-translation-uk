<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\interfacing\tch_mut_table.txt" original="dialogs\interfacing\tch_mut_table.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::This looks like a solid place to deploy the T-ray emitter since it's one of the rare spots in the room not covered with sludge.::&lt;end&gt;</source>
        <target state="needs-translation">::Це виглядає як надійне місце для розгортання Т-променевого випромінювача, оскільки це одне з небагатьох місць у кімнаті, не покрите багнюкою.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a2" name="=&gt;a2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Deploy the T-ray emitter.::&lt;end&gt;</source>
        <target state="needs-translation">::Розгорніть Т-променевий випромінювач.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::You carefully deploy the device on the table, making sure that it is stable enough. Upon activating the device it starts to produce a faint hum, only audible if you are standing right next to it.::&lt;end&gt;</source>
        <target state="needs-translation">::Ви обережно розгортаєте пристрій на столі, переконуючись, що він достатньо стабільний. Після активації пристрій починає видавати слабкий гул, який чутно лише тоді, коли ви стоїте поруч із ним.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a4" name="=&gt;a4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Leave.::&lt;end&gt;</source>
        <target state="needs-translation">::Залишити.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::It's a table with a T-ray emitter on it.::&lt;end&gt;</source>
        <target state="needs-translation">::Це стіл з випромінювачем Т-променів на ньому.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::It's a table.::&lt;end&gt;</source>
        <target state="needs-translation">::Це стіл.::&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
