  <file id="dialogs\interfacing\lux_b2_gate.txt" original="dialogs\interfacing\lux_b2_gate.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The gate appears to be stuck.::&lt;end&gt;</source>
        <target state="needs-translation">::Ворота, здається, застрягли.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a2" name="=&gt;a2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave.::&lt;end&gt;</source>
        <target state="needs-translation">::Залиште мене.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The Dreadnought is too big to pass under the gate.::&lt;end&gt;</source>
        <target state="needs-translation">::Дредноут занадто великий, щоб пройти під воротами.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a4" name="=&gt;a4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave.::&lt;end&gt;</source>
        <target state="needs-translation">::Залиште мене.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The gate is just slightly raised and seems stuck in that position. ::&lt;end&gt;</source>
        <target state="needs-translation">::Ворота трохи підняті і, здається, застрягли в такому положенні.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You're too big to crawl underneath it, though.::&lt;end&gt;</source>
        <target state="needs-translation">::Ти занадто великий, щоб проповзти під ним.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a7" name="=&gt;a7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Try lifting it up.::&lt;end&gt;</source>
        <target state="needs-translation">::Спробуй підняти його.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You pull as hard as you can, but the gate doesn't move a bit.

You feel something leaking from your tumors and down your body, and you let go.::&lt;end&gt;</source>
        <target state="needs-translation">::Ти тягнеш якнайсильніше, але ворота навіть не зрушуються з місця.

Ти відчуваєш, як щось витікає з твоїх пухлин і стікає по тілу, і відпускаєш.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave.::&lt;end&gt;</source>
        <target state="needs-translation">::Залиш.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::There is just enough space for you to crawl under.::&lt;end&gt;</source>
        <target state="needs-translation">::Там достатньо місця, щоб ти міг проповзти під ним.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a11" name="=&gt;a11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Try to crawl under.::&lt;end&gt;</source>
        <target state="needs-translation">::Спробуй проповзти під ними.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The space was narrow, but you made it through.::&lt;end&gt;</source>
        <target state="needs-translation">::Місце було вузьким, але ти проліз.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The space was narrow, but you made it through.::&lt;end&gt;</source>
        <target state="needs-translation">::Місце було вузьким, але ти проліз.::&lt;end&gt;</target>
      </segment>
    </unit>
