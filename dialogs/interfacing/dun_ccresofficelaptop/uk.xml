    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::The deeper they went into the mines, the farther to the east they had to dig. The cost of these operations was raising by the minute, and we expect them to stop soon enough. At least, we hope so. ::&lt;end&gt;</source>
        <target state="needs-translation">::Чим глибше вони заходили в шахти, тим далі на схід їм доводилося копати. Вартість цих операцій зростала щохвилини, і ми очікуємо, що вони скоро припиняться. Принаймні, ми на це сподіваємося. ::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a7" name="=&gt;a7">
      <mda:metadata>
