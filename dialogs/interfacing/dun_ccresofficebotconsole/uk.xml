      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Mismatched sequence, please try again.::&lt;end&gt;</source>
        <target state="needs-translation">::Неправильна послідовність, спробуйте ще раз.::&lt;end&gt;</target>
      </segment>
