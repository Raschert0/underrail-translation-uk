        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">76</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Please answer my question, $(#brother/sister); I'm just following the rules.&lt;end&gt;</source>
        <target state="needs-translation">Будь ласка, дайте відповідь на моє запитання, $(#брате/сестро); я просто виконую правила.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a39" name="=&gt;a39">
