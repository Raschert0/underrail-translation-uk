        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Oh, and I might need to take several trips back and forth.&lt;end&gt;</source>
        <target state="needs-translation">О, і мені, можливо, доведеться кілька разів ходити туди-сюди.&lt;end&gt;</target>
      </segment>
    </unit>
