        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What for?&lt;end&gt;</source>
        <target state="needs-translation">З якою метою?&lt;end&gt;</target>
      </segment>
    </unit>
