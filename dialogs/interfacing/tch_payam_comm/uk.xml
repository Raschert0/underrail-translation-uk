        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You get no response.::&lt;end&gt;</source>
        <target state="needs-translation">::Ви не отримуєте відповіді.::&lt;end&gt;</target>
      </segment>
