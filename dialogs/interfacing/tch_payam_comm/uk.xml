        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Opening the gate now, $(#brother/sister). Tchort guide you.&lt;end&gt;</source>
        <target state="needs-translation">Відкриваю ворота зараз, $(#брате/сестро). Тчорт веди тебе.&lt;end&gt;</target>
      </segment>
