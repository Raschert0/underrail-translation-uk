        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What is the reason for your egress, $(#brother/sister)?&lt;end&gt;</source>
        <target state="needs-translation">Яка причина вашого виходу, $(#брате/сестро)?&lt;end&gt;</target>
