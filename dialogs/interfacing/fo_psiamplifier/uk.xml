  <file id="dialogs\interfacing\fo_psiamplifier.txt" original="dialogs\interfacing\fo_psiamplifier.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The device is activated. You feel a slight headache when standing near it.::&lt;end&gt;</source>
        <target state="needs-translation">::Пристрій активовано. Ви відчуваєте легкий головний біль, коли стоїте поруч з ним.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The device is deployed, but you can't remember how to use it.::&lt;end&gt;</source>
        <target state="needs-translation">::Пристрій розгорнуто, але ви не пам'ятаєте, як ним користуватися.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a3" name="=&gt;a3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave it alone.::&lt;end&gt;</source>
        <target state="needs-translation">::Залиште його в спокої.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The device is deployed and ready to be activated.::&lt;end&gt;</source>
        <target state="needs-translation">::Пристрій розгорнуто та готовий до активації.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a5" name="=&gt;a5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Activate the device.::&lt;end&gt;</source>
        <target state="needs-translation">::Активуйте пристрій.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The device is now activated.::&lt;end&gt;</source>
        <target state="needs-translation">::Пристрій зараз активовано.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The device is deployed, but you feel it is not wise to activate it at this particular moment.::&lt;end&gt;</source>
        <target state="needs-translation">::Пристрій розгорнуто, але ви відчуваєте, що зараз не варто його активувати.::&lt;end&gt;</target>
      </segment>
    </unit>
