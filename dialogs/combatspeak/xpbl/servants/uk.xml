<?xml version='1.0' encoding='utf-8'?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\combatspeak\xpbl\servants.txt" original="dialogs\combatspeak\xpbl\servants.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Your actions seem to be ineffective, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Ваші дії здаються неефективними, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>My body was designed to withstand such abuse, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Моє тіло було створене, щоб витримувати таке знущання, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Please cease this.&lt;end&gt;</source>
        <target state="needs-translation">Припиніть це, будь ласка.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You are being needlessly destructive.&lt;end&gt;</source>
        <target state="needs-translation">Ви без потреби руйнуєте все.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You are causing significant damage to me, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Ви завдаєте мені значної шкоди, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>It is forbidden to scorch a servant, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Заборонено палити слугу, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>My components are not rated for temperatures this low, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Мої компоненти не розраховані на такі низькі температури, $(#сер/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>$(#Sir/Ma'am)... please... stop...&lt;end&gt;</source>
        <target state="needs-translation">(Пане/Пані)... будь ласка... зупиніться...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Do you have a permit for that weapon, $(#sir/ma'am)?&lt;end&gt;</source>
        <target state="needs-translation">У вас є дозвіл на цю зброю, $(#sir/ma'am)?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I must kindly inform you that I am not a dart board, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Я мушу ввічливо повідомити вам, що я не мішень для дротиків, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Stop hitting me, please.&lt;end&gt;</source>
        <target state="needs-translation">Перестаньте мене бити, будь ласка.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>This unit is in no need of engraving, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Цей пристрій не потребує гравіювання, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I am in need of repairs.&lt;end&gt;</source>
        <target state="needs-translation">Мені потрібен ремонт.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Please inform a technician of my failing mechanisms, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Будь ласка, повідомте техніку про несправність моїх механізмів, (пане/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>My body is melting, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Моє тіло тане, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The low temperature is hampering my ability to be of service, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Низька температура перешкоджає моїй здатності бути корисним, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q17" name="=&gt;q17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>It seems I am unable to move, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Здається, я не можу рухатися, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q18" name="=&gt;q18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Resistance is highly inappropriate.&lt;end&gt;</source>
        <target state="needs-translation">Опір абсолютно недоречний.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q19" name="=&gt;q19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>This might feel mildly uncomfortable, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Це може бути трохи неприємно, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q20" name="=&gt;q20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I have been assembled to serve. But not you, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Мене зібрали, щоб служити. Але не вам, $(#сер/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q21" name="=&gt;q21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I notice you are feeling stressed, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Я помічаю, що ви відчуваєте стрес, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q22" name="=&gt;q22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">44</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Your presence is considered rude, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Ваша присутність вважається грубістю, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q23" name="=&gt;q23">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">46</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We are almost done, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Ми майже закінчили, (пане/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q24" name="=&gt;q24">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">48</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You appear as if you need help from a physician. Please do not seek one.&lt;end&gt;</source>
        <target state="needs-translation">Ви виглядаєте так, ніби вам потрібна допомога лікаря. Будь ласка, не шукайте її.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q25" name="=&gt;q25">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">50</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Your body is failing, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Ваше тіло відмовляє, (пане/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q26" name="=&gt;q26">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">52</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I apologize if I have caused you too much unnecessary suffering.&lt;end&gt;</source>
        <target state="needs-translation">Вибачте, якщо я завдав вам надмірних непотрібних страждань.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q27" name="=&gt;q27">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">54</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You are shivering.&lt;end&gt;</source>
        <target state="needs-translation">Ви тремтите.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q28" name="=&gt;q28">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Freezing you will facilitate your disposal immensely, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Заморожування значно полегшить вашу утилізацію, (пане/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q29" name="=&gt;q29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">58</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Please stand by for cremation.&lt;end&gt;</source>
        <target state="needs-translation">Будь ласка, зачекайте на кремацію.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q30" name="=&gt;q30">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">60</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Do you need any assistance with further increasing your temperature?&lt;end&gt;</source>
        <target state="needs-translation">Вам потрібна допомога з подальшим підвищенням температури?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q31" name="=&gt;q31">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">62</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Do not interfere with the flames, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Не заважайте полум'ю, (пане/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q32" name="=&gt;q32">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">64</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Thank you for being still.&lt;end&gt;</source>
        <target state="needs-translation">Дякую, що залишаєтесь нерухомим.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q33" name="=&gt;q33">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">66</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Can you hear me, $(#sir/ma'am)?&lt;end&gt;</source>
        <target state="needs-translation">Ви мене чуєте, (пане/пані)?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q34" name="=&gt;q34">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>If you need to vomit, please proceed to a bathroom.&lt;end&gt;</source>
        <target state="needs-translation">Якщо вам потрібно блювати, будь ласка, зайдіть до вбиральні.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q35" name="=&gt;q35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Your blood is staining the floor, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Ваша кров забарвлює підлогу, (пане/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q36" name="=&gt;q36">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">72</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Do not try to stop your bleeding.&lt;end&gt;</source>
        <target state="needs-translation">Не намагайтеся зупинити кровотечу.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q37" name="=&gt;q37">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">74</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You are wasting your energy, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Ви даремно витрачаєте свою енергію, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q38" name="=&gt;q38">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">76</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I am most sorry for your miss.&lt;end&gt;</source>
        <target state="needs-translation">Мені дуже шкода за вашу втрату.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q39" name="=&gt;q39">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">78</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Practice makes perfect, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Практика робить майстра, $(#сер/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q40" name="=&gt;q40">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">80</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>$(#Sir/Ma'am), I--&lt;end&gt;</source>
        <target state="needs-translation">$(#Сер/Пані), я--&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q41" name="=&gt;q41">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">82</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Please--&lt;end&gt;</source>
        <target state="needs-translation">Будь ласка--&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q42" name="=&gt;q42">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">84</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I am going to need to dispose of you, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Мені доведеться позбутися вас, $(#сер/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q43" name="=&gt;q43">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">86</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Be certain that I will dispose of you in accordance with proper manners.&lt;end&gt;</source>
        <target state="needs-translation">Будьте певні, я позбавлюся вас згідно з правилами етикету.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q44" name="=&gt;q44">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">88</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Please remain still as to simplify the disposal procedure.&lt;end&gt;</source>
        <target state="needs-translation">Будь ласка, залишайтеся нерухомими, щоб спростити процедуру позбавлення.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q45" name="=&gt;q45">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">90</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Please do not shield your eyes.&lt;end&gt;</source>
        <target state="needs-translation">Будь ласка, не закривайте очі.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q46" name="=&gt;q46">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">92</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Is anybody there?&lt;end&gt;</source>
        <target state="needs-translation">Тут хтось є?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q47" name="=&gt;q47">
