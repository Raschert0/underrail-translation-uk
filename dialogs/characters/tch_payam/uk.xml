<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\characters\tch_payam.txt" original="dialogs\characters\tch_payam.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I will cull every single one of them! Tchort is evolution!&lt;end&gt;</source>
        <target state="needs-translation">Я знищу кожного з них! Тчорт - це еволюція!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Move along.&lt;end&gt;</source>
        <target state="needs-translation">Проходьте.</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The rassophore turns to you and silently watches you for a few moments, as if expecting you to say something first.::&lt;end&gt;</source>
        <target state="needs-translation">::Рассофор повертається до вас і мовчки дивиться на вас кілька моментів, ніби чекає, що ви щось скажете першим.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a4" name="=&gt;a4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tchort is Evolution, brother.&lt;end&gt;</source>
        <target state="needs-translation">Тчорт - це еволюція, брате.</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::His raises his head just slightly and answers with a slow, unhurried voice.::

&lt;end&gt;</source>
        <target state="needs-translation">::Він піднімає голову лише трохи і відповідає повільним, неквапливим голосом.::

&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You are supposed to greet a Tchortist with "Tchort is evolution," not "hey, there." Just so you know for future reference $(#brother/sister), or someone might take offense.&lt;end&gt;</source>
        <target state="needs-translation">Ви повинні вітати Тчортиста словами "Тчорт - це еволюція", а не "привіт". Просто щоб ви знали на майбутнє $(#брате/сестро), інакше хтось може образитися.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I am Rassophore Payam and I am in charge of monitoring and security. What can I do for you?&lt;end&gt;</source>
        <target state="needs-translation">Я Рассофор Паям і відповідаю за моніторинг і безпеку. Чим я можу вам допомогти?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Can you open the gate for me?&lt;end&gt;</source>
        <target state="needs-translation">Чи можете ви відкрити ворота для мене?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He nods.:: Tchort guide you.&lt;end&gt;</source>
        <target state="needs-translation">::Він киває.:: Нехай Тчорт веде вас.</target>
      </segment>
    </unit>
    <unit id="=&gt;a11" name="=&gt;a11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tchort guide you too, brother.&lt;end&gt;</source>
        <target state="needs-translation">Нехай Тчорт веде і вас, брате.</target>
      </segment>
    </unit>
    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I need to leave the Institute building.&lt;end&gt;</source>
        <target state="needs-translation">Мені потрібно покинути будівлю Інституту.</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What is the reason for your egress, $(#brother/sister)?&lt;end&gt;</source>
        <target state="needs-translation">Яка причина вашого виходу, $(#брате/сестро)?</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a15" name="=&gt;a15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm on official Institute business.&lt;end&gt;</source>
        <target state="needs-translation">Я виконую офіційне завдання Інституту.</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Official business? On whose authority?&lt;end&gt;</source>
        <target state="needs-translation">Офіційні справи? З чиєї згоди?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a17" name="=&gt;a17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Principal Investigator Rista.&lt;end&gt;</source>
        <target state="needs-translation">Старший слідчий Ріста.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q18" name="=&gt;q18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yes, I have been informed of that, $(#brother/sister).&lt;end&gt;</source>
        <target state="needs-translation">Так, мене про це повідомили, $(#брате/сестро).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a19" name="=&gt;a19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Oh, and I might need to take several trips back and forth.&lt;end&gt;</source>
        <target state="needs-translation">О, і мені, можливо, доведеться кілька разів ходити туди-сюди.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q20" name="=&gt;q20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He nods.:: I will note that. Tchort guide you, $(#brother/sister).&lt;end&gt;</source>
        <target state="needs-translation">::Він киває.:: Я це відзначу. Нехай Тчорт веде тебе, $(#брате/сестро).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a21" name="=&gt;a21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Principal Investigator Georgis.&lt;end&gt;</source>
        <target state="needs-translation">Старший слідчий Георгіс.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a22" name="=&gt;a22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">44</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Principal Investigator Schteff.&lt;end&gt;</source>
        <target state="needs-translation">Старший слідчий Штефф.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a23" name="=&gt;a23">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">46</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Uh...&lt;end&gt;</source>
        <target state="needs-translation">Ем...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q24" name="=&gt;q24">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">48</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I don't know anyone called "Uh." In fact, I should warn you not to give false statements concerning your egress.&lt;end&gt;</source>
        <target state="needs-translation">Я не знаю нікого на ім'я "Ем". Насправді, я повинен попередити вас не давати неправдивих свідчень щодо вашого виходу.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a25" name="=&gt;a25">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">50</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>It's a private matter.&lt;end&gt;</source>
        <target state="needs-translation">Це особиста справа.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q26" name="=&gt;q26">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">52</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What kind of a private matter?&lt;end&gt;</source>
        <target state="needs-translation">Яка саме особиста справа?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a27" name="=&gt;a27">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">54</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>It's very personal.&lt;end&gt;</source>
        <target state="needs-translation">Це дуже особисто.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q28" name="=&gt;q28">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>How long will you be out?&lt;end&gt;</source>
        <target state="needs-translation">Як довго ви будете відсутні?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a29" name="=&gt;a29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">58</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll be back quickly.&lt;end&gt;</source>
        <target state="needs-translation">Я швидко повернусь.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q30" name="=&gt;q30">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">60</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Everything you said has been noted. I will open the gate for you now, $(#brother/sister). Tchort guide you.&lt;end&gt;</source>
        <target state="needs-translation">Все, що ви сказали, було занотовано. Я зараз відкрию ворота для вас, $(#брате/сестро). Нехай Тчорт веде тебе.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a31" name="=&gt;a31">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">62</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Not soon, that's for sure.&lt;end&gt;</source>
        <target state="needs-translation">Не скоро, це точно.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a32" name="=&gt;a32">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">64</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I have no idea.&lt;end&gt;</source>
        <target state="needs-translation">Я не знаю.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a33" name="=&gt;a33">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">66</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I need to meet someone.&lt;end&gt;</source>
        <target state="needs-translation">Мені потрібно зустрітися з кимось.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a34" name="=&gt;a34">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>To roam South Underrail.&lt;end&gt;</source>
        <target state="needs-translation">Помандрувати Південним Андеррейлом.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a35" name="=&gt;a35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I need to visit my station.&lt;end&gt;</source>
        <target state="needs-translation">Мені потрібно відвідати мою станцію.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a36" name="=&gt;a36">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">72</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Nothing important, I'm just going to the courtyard.&lt;end&gt;</source>
        <target state="needs-translation">Нічого важливого, я просто йду у двір.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q37" name="=&gt;q37">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">74</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What for?&lt;end&gt;</source>
        <target state="needs-translation">З якою метою?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a38" name="=&gt;a38">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">76</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Just to stretch my legs.&lt;end&gt;</source>
        <target state="needs-translation">Просто розім'яти ноги.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a39" name="=&gt;a39">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">78</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>To talk to some of the people out front.&lt;end&gt;</source>
        <target state="needs-translation">Поговорити з деякими людьми попереду.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a40" name="=&gt;a40">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">80</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Could you just let me go without all these questions?&lt;end&gt;</source>
        <target state="needs-translation">Чи можете ви просто дозволити мені піти без усіх цих питань?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q41" name="=&gt;q41">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">82</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Please answer my question, $(#brother/sister); I'm simply following the proper procedure.&lt;end&gt;</source>
        <target state="needs-translation">Будь ласка, дайте відповідь на моє запитання, $(#брате/сестро); я просто дотримуюся належної процедури.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a42" name="=&gt;a42">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">84</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Are you in charge of opening the main gate?&lt;end&gt;</source>
        <target state="needs-translation">Ви відповідаєте за відкриття головних воріт?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q43" name="=&gt;q43">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">86</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yes, that is correct. All arrivals and departures are carefully monitored from this very room and if you, for instance, wished to leave the building, you'd have to use that intercom there and state the reason for your movement.&lt;end&gt;</source>
        <target state="needs-translation">Так, це правильно. Усі прибуття та відправлення ретельно контролюються з цієї кімнати, і якщо ви, наприклад, захочете покинути будівлю, вам доведеться скористатися тим домофоном і вказати причину свого пересування.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a44" name="=&gt;a44">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">88</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>So every time someone wants to enter or leave has to answer to you?&lt;end&gt;</source>
        <target state="needs-translation">Тож кожного разу, коли хтось хоче увійти чи вийти, він повинен відповідати перед вами?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q45" name="=&gt;q45">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">90</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Well, I am most certainly not going to question notability regarding their reasons for leaving or entering the Institute building; magnificent Tchort, no. But we can't have, for instance, a novitiate like you simply stroll in and out however $(#he/she) pleases without answering to anyone.&lt;end&gt;</source>
        <target state="needs-translation">Ну, я, звісно, не збираюся ставити під сумнів важливість їхніх причин для виходу чи входу в будівлю Інституту; величний Тчорт, ні. Але ми не можемо дозволити, наприклад, новачку, як ви, просто ходити туди-сюди, як $(#він/вона) забажає, не відповідаючи перед кимось.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q46" name="=&gt;q46">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">92</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The procedures are there to be followed and respected, and if it is bothering you, you better adapt to it.&lt;end&gt;</source>
        <target state="needs-translation">Процедури існують, щоб їх дотримуватися та поважати, і якщо це вас турбує, вам краще до них адаптуватися.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a47" name="=&gt;a47">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">94</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Gotcha. Now let me ask you something else.&lt;end&gt;</source>
        <target state="needs-translation">Зрозуміло. Тепер дозвольте мені запитати вас про щось інше.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q48" name="=&gt;q48">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">96</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Right, but keep it short, $(#brother/sister).&lt;end&gt;</source>
        <target state="needs-translation">Гаразд, але будьте лаконічні, $(#брате/сестро).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a49" name="=&gt;a49">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">98</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I would like to ask you several questions about Tchortism.&lt;end&gt;</source>
        <target state="needs-translation">Я хотів би поставити вам кілька запитань про Тчортизм.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q50" name="=&gt;q50">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">100</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I am sorry, but I'm busy at the moment. My recommendation would be to either visit Eidein's Library or talk to someone from Propagation - Praepostor Amelia, for instance.&lt;end&gt;</source>
        <target state="needs-translation">Вибачте, але я зараз зайнятий. Я рекомендую вам відвідати Бібліотеку Ейдейна або поговорити з кимось із Пропаганди – наприклад, з Препостором Амелією.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q51" name="=&gt;q51">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">102</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Of course, reading the Original Report should be your priority, if you haven't done so already. Anything else?&lt;end&gt;</source>
        <target state="needs-translation">Звичайно, прочитання Оригінального звіту має бути вашим пріоритетом, якщо ви ще цього не зробили. Щось ще?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a52" name="=&gt;a52">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">104</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What does a cell about to undergo mitosis say to an interested investigator? "I hope I have your divided attention!"&lt;end&gt;</source>
        <target state="needs-translation">Що говорить клітина, яка збирається пройти мітоз, зацікавленому слідчому? "Сподіваюся, ви приділите мені розділену увагу!"&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q53" name="=&gt;q53">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">106</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He responds in his usual, slow manner of talking.::

Excuse me, $(#brother/sister)? Why are you telling me this?&lt;end&gt;</source>
        <target state="needs-translation">::Він відповідає своїм звичайним, повільним тоном мовлення.::

Вибачте, $(#брате/сестро)? Навіщо ви мені це говорите?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a54" name="=&gt;a54">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">108</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>It's a joke!&lt;end&gt;</source>
        <target state="needs-translation">Це жарт!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q55" name="=&gt;q55">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">110</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>A joke?&lt;end&gt;</source>
        <target state="needs-translation">Жарт?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a56" name="=&gt;a56">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">112</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yeah, you know. Mitosis is a form of cell division... divided attention... get it?&lt;end&gt;</source>
        <target state="needs-translation">Так, знаєте. Мітоз – це форма поділу клітин... розділена увага... зрозуміло?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q57" name="=&gt;q57">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">114</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Your statement is met with a statue-like stillness. The awkward moment doesn't last long, however.::

I know what mitosis is, I just don't understand why you think the "joke" you told me is so funny?&lt;end&gt;</source>
        <target state="needs-translation">::Ваша заява зустрічається зі статуєю подібною нерухомістю. Однак незручний момент триває недовго.::

Я знаю, що таке мітоз, я просто не розумію, чому ви вважаєте, що "жарт", який ви мені розповіли, такий смішний?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a58" name="=&gt;a58">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">116</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Forget it. Just forget it.&lt;end&gt;</source>
        <target state="needs-translation">Забудьте. Просто забудьте.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q59" name="=&gt;q59">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">118</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He shrugs.:: Anything else?&lt;end&gt;</source>
        <target state="needs-translation">::Він знизує плечима.:: Щось ще?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a60" name="=&gt;a60">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">120</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Do fights or shootouts ever occur between people right outside the main gate?&lt;end&gt;</source>
        <target state="needs-translation">Чи трапляються бійки або перестрілки між людьми прямо біля головних воріт?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q61" name="=&gt;q61">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">122</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Fights - rarely; shootings - never. Sometimes a brawl would break out, but mostly between inbreds who aren't worthy of our attention in the first place and had just arrived to cause trouble. Still, when these things do occur, we usually react quickly and deal with the situation.&lt;end&gt;</source>
        <target state="needs-translation">Бійки – рідко; перестрілки – ніколи. Іноді може виникнути бійка, але здебільшого між виродками, які не заслуговують на нашу увагу і щойно прибули, щоб спричинити проблеми. Тим не менш, коли таке трапляється, ми зазвичай швидко реагуємо та вирішуємо ситуацію.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q62" name="=&gt;q62">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">124</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Excluding those, incidents are rare in the Institute courtyard. Visitors feel safe here, and that's how we intend them to.&lt;end&gt;</source>
        <target state="needs-translation">За винятком цих випадків, інциденти рідкісні у дворі Інституту. Відвідувачі почуваються тут у безпеці, і ми маємо намір, щоб вони так почувалися.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a63" name="=&gt;a63">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">126</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I am looking for Rassophore Nevil; did he perhaps leave through the front gate?&lt;end&gt;</source>
        <target state="needs-translation">Я шукаю Рассофора Невіла; чи не виходив він через головні ворота?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q64" name="=&gt;q64">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">128</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Negative, he couldn't get past without me knowing it.&lt;end&gt;</source>
        <target state="needs-translation">Ні, він не міг пройти повз мене, не знаючи про це.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q65" name="=&gt;q65">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">130</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I was informed and asked about the commotion regarding Rassophore Nevil's disappearance and I can confirm that he didn't pass through the main gate.&lt;end&gt;</source>
        <target state="needs-translation">Мене поінформували та запитали про переполох щодо зникнення Рассофора Невіла, і я можу підтвердити, що він не проходив через головні ворота.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a66" name="=&gt;a66">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">132</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Goodbye, Payam.&lt;end&gt;</source>
        <target state="needs-translation">До побачення, Паям.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q67" name="=&gt;q67">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">134</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>It's "Tchort guide you." Tchort guide you, $(#brother/sister).&lt;end&gt;</source>
        <target state="needs-translation">Це "Нехай Тчорт веде тебе". Нехай Тчорт веде тебе, $(#брате/сестро).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a68" name="=&gt;a68">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">136</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tchort guide you, brother.&lt;end&gt;</source>
        <target state="needs-translation">Нехай Тчорт веде тебе, брате.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q69" name="=&gt;q69">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">138</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tchort guide you, $(#brother/sister).&lt;end&gt;</source>
        <target state="needs-translation">Нехай Тчорт веде тебе, $(#брате/сестро).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q70" name="=&gt;q70">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">140</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Evolution is Tchort, $(#brother/sister). &lt;end&gt;</source>
        <target state="needs-translation">Еволюція – це Тчорт, $(#брате/сестро).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a71" name="=&gt;a71">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">142</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hey there.&lt;end&gt;</source>
        <target state="needs-translation">Привіт.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a72" name="=&gt;a72">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">144</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Remain silent.::&lt;end&gt;</source>
        <target state="needs-translation">::Замовкнути.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q73" name="=&gt;q73">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">146</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He waits for several more seconds before slightly raising his head and speaking in a slow, unhurried voice.::

&lt;end&gt;</source>
        <target state="needs-translation">::Він чекає ще кілька секунд, перш ніж трохи підняти голову і говорити повільним, неквапливим голосом.::

&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q74" name="=&gt;q74">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">148</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tchort is evolution, $(#brother/sister).&lt;end&gt;</source>
        <target state="needs-translation">Тчорт – це еволюція, $(#брате/сестро).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a75" name="=&gt;a75">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">150</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hey there.&lt;end&gt;</source>
        <target state="needs-translation">Привіт.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q76" name="=&gt;q76">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">152</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>When a Tchortist greets you with "Tchort is evolution," you reply with "Evolution is Tchort" and not "hey, there." Just so you know for future reference $(#brother/sister), or someone might take offense.&lt;end&gt;</source>
        <target state="needs-translation">Коли Тчортист вітає вас словами "Тчорт – це еволюція", ви відповідаєте "Еволюція – це Тчорт", а не "привіт". Просто знайте це на майбутнє $(#брате/сестро), інакше хтось може образитися.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a77" name="=&gt;a77">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">154</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Evolution is Tchort, brother.&lt;end&gt;</source>
        <target state="needs-translation">Еволюція – це Тчорт, брате.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q78" name="=&gt;q78">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">156</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tchort is evolution. What can I do for you?&lt;end&gt;</source>
        <target state="needs-translation">Тчорт – це еволюція. Що я можу для вас зробити?&lt;end&gt;</target>
      </segment>
    </unit>
