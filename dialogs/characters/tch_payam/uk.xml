    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You are supposed to greet a Tchortist with "Tchort is evolution," not "hey, there." Just so you know for future reference $(#brother/sister), or someone might take offense.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
