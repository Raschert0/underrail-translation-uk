  <file id="dialogs\characters\jy_kohlmeier.txt" original="dialogs\characters\jy_kohlmeier.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Go to hell!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I miss my knife.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I feel my luck is starting to change already!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Any luck?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a5" name="=&gt;a5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Here's your knife, old timer. ::Give him the knife.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hee-hee, my old lucky knife! I thought I'd never see you again!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a7" name="=&gt;a7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Well, I'll leave you two to catch up.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hey... thanks. Best of luck, youngster.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You're welcome, and you too, old timer. Goodbye.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a10" name="=&gt;a10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yeah, I found it, and it turns out it's a pretty good knife so I'm keeping it.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What? You greedy bastard! I hope you fall over and stab yourself!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll be careful, don't worry. Bye, old fart.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a13" name="=&gt;a13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Sorry, I looked everywhere but couldn't find your knife.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>That... bastard must have sold it at some point. I waited too long. I should have gone looking for it myself earlier. Curse these old bones!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a15" name="=&gt;a15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Well, that's that, old timer. I wish you the very best.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He nods.:: Yeah, I wish it too...&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a17" name="=&gt;a17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tough. Bye.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q18" name="=&gt;q18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He nods.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a19" name="=&gt;a19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tell me something about yourself, old timer.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q20" name="=&gt;q20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why are you interested in knowing more about an old man like me?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a21" name="=&gt;a21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Older, I'd say.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q22" name="=&gt;q22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">44</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He laughs.:: Old. There's no use in trying to kid ourselves. I mean, us old folks. We're old, and we're gonna be gone soon. Old-er, that's the word those who don't wanna accept the way life works, with all it's ups... and downs.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a23" name="=&gt;a23">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">46</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I see. So, are you going to tell me something about yourself. You told me about the house, so why not go back in past some more.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q24" name="=&gt;q24">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">48</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Well... my life was one that had *quite* a few ups and downs. I'd rather not go into too many details, but I had a great wife, a good job, decent kids and a life I wouldn't complain about. First I lost my wife, then I lost my job, then my kids left... then I started complaining about life. ::He smiles.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a25" name="=&gt;a25">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">50</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What happened?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q26" name="=&gt;q26">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">52</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I... said I wouldn't wanna get into too many details. Some of the things were my fault, some were bad luck. In the end, I ended up in Junkyard. And then after that, in an even worse part of Junkyard. I guess ground's next. ::He laughs.:: Well, to be honest, at least these United Stations bozos were helping us up until South Railroad Outpost was attacked.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a27" name="=&gt;a27">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">54</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Have the United Stations been treating you well?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q28" name="=&gt;q28">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yes. Yes, indeed they have. I was in the same... boat as a lot of the folks in Junkyard when we first heard them... eh, Northerners were gonna construct an embassy here. But, I have a different opinion now. They've been good to us folks here. They give us food and old clothes we can wear, and we're a bit safer here. Although, once you get past Vince and his pack you're back in dangerous territory.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q29" name="=&gt;q29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">58</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Although, no one left the embassy ever since the South Railroad Outpost was attacked. But I'm sure Protectorate will take care of the Drones sometime soon. They *can't* hold it, you know. Then I think things'll normalize a bit.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a30" name="=&gt;a30">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">60</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I see. I gotta go. See you later.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a31" name="=&gt;a31">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">62</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Life's tough. I'll be going now, old timer.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q32" name="=&gt;q32">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">64</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Oh, well. That's Junkyard.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a33" name="=&gt;a33">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">66</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Where does the knife fit in?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q34" name="=&gt;q34">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Somewhere in between. Just having it helped me get through... some of the downs in my life. That's all you need to know.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a35" name="=&gt;a35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Look, can I help you out somehow? Do you need any food?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q36" name="=&gt;q36">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">72</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We're good. The United Station folks help us with that. I'd just like that knife. That's all I want.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a37" name="=&gt;a37">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">74</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm sorry to hear that. Can I help you somehow? Do you need any food?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q38" name="=&gt;q38">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">76</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I... said I wouldn't wanna get into too many details. Some of the things were my fault, some were bad luck. In the end, I ended up in Junkyard. And then after that, in an even worse part of Junkyard. I guess ground's next. ::He laughs.:: Well, to be honest, at least these United Stations bozos are helping us out a bit. &lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a39" name="=&gt;a39">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">78</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I get what you're saying, but I gotta go. See you around, old timer.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a40" name="=&gt;a40">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">80</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Just wanted to hear your story. You told me about the house, so why not go back in past some more.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a41" name="=&gt;a41">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">82</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hmmm, good question. I guess I'll leave you be then. So long, old timer.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q42" name="=&gt;q42">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">84</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Huh?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a43" name="=&gt;a43">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">86</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Still working on it.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q44" name="=&gt;q44">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">88</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You see an elderly, dried-up man eating some raw mushrooms, taking them one by one from his palm until it is completely empty of everything but a thick layer of hardened skin. He stares at you, still chewing through the last mushroom, and after swallowing it, he speaks.::

Hey, stranger. I... can see you are not from around here. ::He pauses, and his stare wanders around. Then he continues.:: Might you, by any chance, be interested in a little business proposition?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a45" name="=&gt;a45">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">90</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What did you have in mind, old timer?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q46" name="=&gt;q46">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">92</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He beckons you closer.:: I didn't always live in a tent, you know. I used to live in the residential area to the east. Really, I did.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q47" name="=&gt;q47">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">94</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I lived in a comfy house on the east side. Oh, yeah. But, one day I couldn't pay protection money to the Eels anymore so they kicked me out. Heartless bastards. However, I'm not gonna waste your time with my... sob story, no.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q48" name="=&gt;q48">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">96</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The important... bit is that I know a secret way back into my old home. And I also know that its current occupant has quite a bit of coins lying around there.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a49" name="=&gt;a49">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">98</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>So you'll tell me how to get in there in exchange for a cut of the profits?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q50" name="=&gt;q50">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">100</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What? Do you think I'm thick? I have no way of making you give me any of that money after the job is done.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q51" name="=&gt;q51">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">102</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The only thing I want is for you to get my lucky knife. It's gotta be lying around somewhere in there. The knife won't be of much use to... *you* since it's not a particularly good knife for combat, but it's of sentimental value to me. Do you dig?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q52" name="=&gt;q52">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">104</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What do you say? We got a deal?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a53" name="=&gt;a53">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">106</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Deal. Now tell me how to get in there.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q54" name="=&gt;q54">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">108</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Great. So about getting in... *Obviously,* you could try the front door if you think you can hack the lock, but it's also being watched by the Eels.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q55" name="=&gt;q55">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">110</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The smart thing to do would be to go to the docks and look for the small shack north of the berths. ::He nods.:: The rocks between the shack and the cave wall can *actually* be dislodged there without breaking a sweat, and you look skinny enough to squeeze through. Not saying you're a squeezer, mind you, just that you're... thin enough. That's all.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q56" name="=&gt;q56">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">112</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>That'll give you access to a tunnel that will lead you straight into the mushroom garden of my old house. I discovered this passage one day when I found a stinkin' rathound messing up my shrooms. Never got around to sealing it off.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q57" name="=&gt;q57">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">114</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Speaking of that, there still might be rathounds in there, so tread carefully.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a58" name="=&gt;a58">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">116</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Alright. I'm off.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a59" name="=&gt;a59">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">118</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll have to think about it.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a60" name="=&gt;a60">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">120</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>So what would you want in return for this information?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a61" name="=&gt;a61">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">122</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Sorry. I don't deal with hobos.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q62" name="=&gt;q62">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">124</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hee-hee! You'll be very lonely here in the Junkyard then.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a63" name="=&gt;a63">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">126</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm sure of it. See you around.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a64" name="=&gt;a64">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">128</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Maybe some other time.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q65" name="=&gt;q65">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">130</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He nods.:: I ain't going nowhere, if you change your mind.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a66" name="=&gt;a66">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">132</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Got it. Bye, old timer.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q67" name="=&gt;q67">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">134</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You are back.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a68" name="=&gt;a68">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">136</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tell me what you had in mind.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a69" name="=&gt;a69">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">138</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You got yourself a deal.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a70" name="=&gt;a70">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">140</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>No, just passing by.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
