  <file id="dialogs\characters\cc_svetlana.txt" original="dialogs\characters\cc_svetlana.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Stop staring at me, bre.&lt;end&gt;</source>
        <target state="needs-translation">Перестань дивитися на мене, брате.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yes?&lt;end&gt;</source>
        <target state="needs-translation">Так?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What is it?&lt;end&gt;</source>
        <target state="needs-translation">Що таке?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The woman aims her crossbow at you.::

Stop, bre! Turn around and leave.&lt;end&gt;</source>
        <target state="needs-translation">::Жінка наводить свій арбалет на вас.::

Стій, брате! Повернись і йди геть.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a7" name="=&gt;a7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I think you might have something I need.&lt;end&gt;</source>
        <target state="needs-translation">Я думаю, у тебе є те, що мені потрібно.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Oh. And what might that be?&lt;end&gt;</source>
        <target state="needs-translation">О. А що ж це може бути?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>A device. A very important device.&lt;end&gt;</source>
        <target state="needs-translation">Пристрій. Дуже важливий пристрій.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Oh, we did relieve some poor wimp of his little toy. Is that whatcha taking about?&lt;end&gt;</source>
        <target state="needs-translation">О, ми позбавили якогось бідолаху його маленької іграшки. Це те, про що ти говориш?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Her greed turns into a smile.:: Are you willing to pay for it?&lt;end&gt;</source>
        <target state="needs-translation">::Її жадібність перетворюється на посмішку.:: Ти готовий за це заплатити?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yes.&lt;end&gt;</source>
        <target state="needs-translation">Так.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Good $(#boy/girl)! Let's go talk to Duffie.&lt;end&gt;</source>
        <target state="needs-translation">Чудово $(#хлопчику/дівчинці)! Ходімо поговоримо з Даффі.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a14" name="=&gt;a14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Follow her.::&lt;end&gt;</source>
        <target state="needs-translation">::Слідуй за нею.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a15" name="=&gt;a15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Perhaps.&lt;end&gt;</source>
        <target state="needs-translation">Можливо.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a16" name="=&gt;a16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Not really.&lt;end&gt;</source>
        <target state="needs-translation">Ні.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q17" name="=&gt;q17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>No? Then you better turn around and beat it, bre, $(#boy/girl). We got nothing more to talk about.&lt;end&gt;</source>
        <target state="needs-translation">Ні? Тоді краще повертайся і тікай, брате, $(#хлопчику/дівчинці). Нам більше нема про що говорити.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a18" name="=&gt;a18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Listen, I changed my mind. I *might* pay for the device.&lt;end&gt;</source>
        <target state="needs-translation">Послухай, я передумав. Я *можу* заплатити за пристрій.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a19" name="=&gt;a19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Fine, I'll go.&lt;end&gt;</source>
        <target state="needs-translation">Добре, я піду.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a20" name="=&gt;a20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>An ICPD. You stole it from a man who came through here recently.&lt;end&gt;</source>
        <target state="needs-translation">Поліцейський Андеррейлу. Ти вкрав його у чоловіка, який нещодавно пройшов тут.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q21" name="=&gt;q21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>IPDC?  You talking about the gizmo we *borrowed* from that wimp?&lt;end&gt;</source>
        <target state="needs-translation">Поліцейський Андеррейлу? Ти говориш про штуковину, яку ми *позичили* у того невдахи?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a22" name="=&gt;a22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">44</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave without saying a word.::&lt;end&gt;</source>
        <target state="needs-translation">::Залишити, не говорячи ні слова.::&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
