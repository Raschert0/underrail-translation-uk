      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">144</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Two hundred charons and the helmet is yours.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q73" name="=&gt;q73">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">146</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Two hundred... Deal. For somethin' like that, well worth it.&lt;end&gt;</source>
        <target state="new" />
      </segment>
