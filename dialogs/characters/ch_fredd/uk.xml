      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">204</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Where are goin'? $(#Mate/Miss)?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q103" name="=&gt;q103">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">206</mda:meta>
      </mda:metadata>
      <segment state="translated">
