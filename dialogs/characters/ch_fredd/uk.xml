        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">164</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He gives you a surprised look, as if unsure whether he understood you well.:: This one? This? I need that for me business. I ain't givin' that for the helmet. Are you derailed?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a83" name="=&gt;a83">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">166</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Then you don't want the helmet that much.&lt;end&gt;</source>
        <target state="new" />
      </segment>
