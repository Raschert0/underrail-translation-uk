        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">148</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::[Mercantile]:: Five hundred charons and the helmet is yours.&lt;end&gt;</source>
