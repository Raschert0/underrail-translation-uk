      <segment state="translated">
        <source>::You notice him slowly breaking. Soon he confirms it.::

It's history. ::He sighs.:: I accept. I accept. Here's the coin. It's all I've got.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q78" name="=&gt;q78">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">156</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I can't give you that much coin. Please, can't we make some decent deal?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a79" name="=&gt;a79">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">158</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::[Mercantile]:: One thousand charons and the helmet is yours.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q80" name="=&gt;q80">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
