    <unit id="=&gt;a46" name="=&gt;a46">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">92</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Anesthetics are for the weak. Bring on the pain, doc. ::Pay three stygian coins.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q47" name="=&gt;q47">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">94</mda:meta>
      </mda:metadata>
