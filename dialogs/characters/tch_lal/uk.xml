        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">120</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm $(context.player.Name) - Invictus. I defeated the mighty Carnifex while being watched by the whole Core City! Be impressed with my hardcoreness.&lt;end&gt;</source>
        <target state="new" />
