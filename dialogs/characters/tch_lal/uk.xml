        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">112</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Damn, I didn't plan on taking a bath yet... ::Wipe the spit off you.:: $(context.player.Name) is the name.&lt;end&gt;</source>
