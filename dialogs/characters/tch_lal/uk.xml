        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">122</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hey, I don't think so. Everyone knows the Invictus is much taller. But, I see a slight resemblance there, bed mate. You do look a bit like $(#him/her).&lt;end&gt;</source>
