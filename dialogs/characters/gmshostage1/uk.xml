  <file id="dialogs\characters\gmshostage1.txt" original="dialogs\characters\gmshostage1.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm glad this is over. I... I didn't think I would survive... but so many died.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I've got nothing worth taking.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a3" name="=&gt;a3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>There's a sealed door at the first level, how do I open them?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I... I don't know.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a5" name="=&gt;a5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::[Intimidate]:: Don't lie to me! One of you bastards must have sealed it off.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I don't know, I swear! Maybe Bloomberg knows... but they killed him. Or Sully... I don't know...&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a7" name="=&gt;a7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave him alone::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a8" name="=&gt;a8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave him alone.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Be careful. There's more of them about...&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Thank you for killing those bastards. But I'm afraid there's more of them.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a11" name="=&gt;a11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What is going on here exactly?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>They stormed our barricade... they killed some. The others are held hostage in the dining hall.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a14" name="=&gt;a14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Who are they?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I don't know... slavers maybe, or just common bandits. I didn't hear them say what they want before I was dragged here to help them access the upper levels.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a16" name="=&gt;a16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Are they well armed?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q17" name="=&gt;q17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Most of them have pistols. There might be more of them with crossbows... Oh, and there's this guy with a sledgehammer.
They don't have much armor on as far as I could tell, though.
&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a18" name="=&gt;a18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Barricade?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q19" name="=&gt;q19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>There's a breach that leads to the caves. Don't know how long it was there, it's how we migrated here. We set up a barricade with an auto-turret to protect it... but it didn't do us much good today.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a20" name="=&gt;a20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>So what do you propose we do?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q21" name="=&gt;q21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I have an idea. They destroyed the auto-turret at the barricade because they were ready for it, but there's still another deactivated one near the elevator.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q22" name="=&gt;q22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">44</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>If you could activate that turret while they are not expecting it, it'll rip them to shreds!

At least those out in the hallway. It'll make dealing with the rest of them easier.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a23" name="=&gt;a23">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">46</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>So how do I activate the turret?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q24" name="=&gt;q24">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">48</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Just left of the elevator, there's a surveillance room. Security console is there as well. The problem is, it's locked. Maybe Sully has the keycard, but I think he's being held hostage in the dining hall. You'll have to hack your way into the surveillance room and then hack the console to gain access to auto-turret controls.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a25" name="=&gt;a25">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">50</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Forget it. I'm not too good at hacking. I'll have to find another way.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q26" name="=&gt;q26">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">52</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He nods.:: Alright.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q27" name="=&gt;q27">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">54</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a28" name="=&gt;a28">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Alright, got it. You stay here.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q29" name="=&gt;q29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">58</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Good luck.... Oh, and by the way, be sure to turn the turret off afterwards. It might think you're an intruder as well and shoot you down if you come near it.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a30" name="=&gt;a30">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">60</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Forget it. I'll take them out my own way.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q31" name="=&gt;q31">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">62</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Alright, if you think you can take them.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a32" name="=&gt;a32">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">64</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Alright, wait here, I'll take care of them.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q33" name="=&gt;q33">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">66</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Wait! &lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a34" name="=&gt;a34">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Not my problem. If you want your freedom, fight for it.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q35" name="=&gt;q35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a36" name="=&gt;a36">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">72</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Don't be thanking me, pops, you're next. ::Attack!::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q37" name="=&gt;q37">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">74</mda:meta>
      </mda:metadata>
