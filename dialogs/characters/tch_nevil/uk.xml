      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">126</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::A roaring sound of large metal gates opening in the distance interrupts him. His heavy breathing becomes even more pronounced, and it takes him a moment to continue.::

They are coming...&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a64" name="=&gt;a64">
      <mda:metadata>
