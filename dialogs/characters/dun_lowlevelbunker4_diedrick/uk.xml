  <file id="dialogs\characters\dun_lowlevelbunker4_diedrick.txt" original="dialogs\characters\dun_lowlevelbunker4_diedrick.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Diedrick and Ryl are visibly happy to see you again.::

Hey, umm, we feel like we didn't make it up to you since the last time we met. Our sales business has been going strong lately. Please take this, it's the least we can do. ::Hands you some coins.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a2" name="=&gt;a2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Thank you.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He shakes your hand as he hands you over the coins; graceful smile shines on his face.:: 

Please... you have no idea how much this means to us.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a4" name="=&gt;a4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>See you around.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a5" name="=&gt;a5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Nod and leave.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a6" name="=&gt;a6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Eh, It was nothing. Nobody's a match for me.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a7" name="=&gt;a7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm all good you guys, I'll let you keep it, I think you need it more than I do.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Aww, come on, you can't just refuse us like that. It would mean a lot to us if you took this. ::He frowns while pushing the coins towards you.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Okay, okay, fine - I'll take it.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a10" name="=&gt;a10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Trust me, I'm just fine. &lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>A selfless hero, aren't you? &lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Call it what you like, but I truly wish the best for you. I'll be seeing you around.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a13" name="=&gt;a13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Nod and leave.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a14" name="=&gt;a14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Take the money and leave.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I feel so lonely. I, ugh... I need some time alone. ::He looks away.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a16" name="=&gt;a16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll reuinite you with your beloved one. ::Attack!::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a17" name="=&gt;a17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q18" name="=&gt;q18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Oh, no ... she... she's gone. Ugh, I... ::Swirl of emotions clouds his mind for a short moment as he is trying to decide what to do next.::

I will uphold my offer but after this, we are done. &lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q19" name="=&gt;q19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q20" name="=&gt;q20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Thank you for saving us; we shall now uphold our bargain. ::He wipes the sweat from his forehead.::

Here is the key card to the storeroom. In addition, as promised, I'll let you browse some of the wares we've gathered.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a21" name="=&gt;a21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Alright, let's see the stuff. ::Barter.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a22" name="=&gt;a22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">44</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm all good for now. ::Leave.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q23" name="=&gt;q23">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">46</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q24" name="=&gt;q24">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">48</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Thank you for saving us; we shall now uphold our bargain. ::He wipes the sweat from his forehead.::

::He reaches for his pockets in search for something. It's quite clear he's unable to find what he was looking for so he starts to search the floor around him. Even that effort is futile as he shows signs of hopelessness by shrugging his shoulders. After a small chat with Ryl, he decides to speak up.::

What the... I was sure it was right there... The damn keycard it... as if it has... perished? Uuugh... we can still sell you some of our stuff? ::He looks down to the ground.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a25" name="=&gt;a25">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">50</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You did promise me the access to the back room out there...&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q26" name="=&gt;q26">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">52</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I... I mean we... we're sorry okay? I have no clue where did I drop the key to that door. Just... just let this one slip for us okay? We'll make it up to you next time for sure! ::You can see the Ryl in background nod as he tells you this.:: &lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a27" name="=&gt;a27">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">54</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Next time? What do you mean?&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q28" name="=&gt;q28">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We're heading back to Junkyard. And there... we'll figure something out, alright?&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a29" name="=&gt;a29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">58</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Fine, I'll meet you there.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q30" name="=&gt;q30">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">60</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Once again he wipes the sweat from his forhead.:: Phew, that almost turned really bad. ::He gives off a nervous expression.:: We're still more than willing to sell you some of our goods.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a31" name="=&gt;a31">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">62</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I don't offer second chances. I'll make you pay for this one way or another! ::Attack!::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a32" name="=&gt;a32">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">64</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>No problem. It happens to everyone, I guess.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a33" name="=&gt;a33">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">66</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Fear not, I took your key. ::Show him the keycard.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q34" name="=&gt;q34">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Woah you sneaky little... umm. *friend* heh heh. ::They both laugh.:: Sheesh, my heart skipped a beat over that one, damn.

Well umm, now that you have it ::He points in the direction of the door for which the card is supposed to be used for.:: we're still willing to sell you some of our goods.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q35" name="=&gt;q35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We're packing up. Back to Junkyard it is then, right Ryl? ::He glances over at her and she gives him back a gentle nod.:: 

While we're still here, you're more than welcome to trade with us.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q36" name="=&gt;q36">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">72</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q37" name="=&gt;q37">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">74</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Soon we'll have just enough. I think we've deserved some rest. &lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q38" name="=&gt;q38">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">76</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q39" name="=&gt;q39">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">78</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a40" name="=&gt;a40">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">80</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Got any interesting stuff? ::Barter.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a41" name="=&gt;a41">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">82</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Just dropped by to say hello. See ya.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a42" name="=&gt;a42">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">84</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Nod and leave.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q43" name="=&gt;q43">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">86</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We meet again, scavenging $(#brother/sister). We've been busy "working" all this time. Check out our new goods.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q44" name="=&gt;q44">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">88</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We are discussing our next destination. Any suggestions?&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q45" name="=&gt;q45">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">90</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Prepare yourself!&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q46" name="=&gt;q46">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">92</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>All we needed is more trouble.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
