    <unit id="=&gt;a57" name="=&gt;a57">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">114</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Can you tell me a bit more about it?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q58" name="=&gt;q58">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">116</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Nope. ::He takes a sip of his drink.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a59" name="=&gt;a59">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">118</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why not?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q60" name="=&gt;q60">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">120</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why should I?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a61" name="=&gt;a61">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">122</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Because I asked you nicely.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q62" name="=&gt;q62">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">124</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Well, tough luck. Any more questions?&lt;end&gt;</source>
