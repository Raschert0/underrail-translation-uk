        <mda:meta type="pos_id">154</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Look, you ask too many questions, $(#bud/sugar). I don't know why I'm even freakin' talking to you.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a78" name="=&gt;a78">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">156</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What can you tell me about Underrail Express?&lt;end&gt;</source>
        <target state="new" />
      </segment>
