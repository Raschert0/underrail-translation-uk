        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">172</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I gotta go.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a87" name="=&gt;a87">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">174</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Well, I told you my name - so I'm not a complete stranger.&lt;end&gt;</source>
