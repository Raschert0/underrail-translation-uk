      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">168</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Can you not call me "sugar"?&lt;end&gt;</source>
        <target state="new" />
      </segment>
