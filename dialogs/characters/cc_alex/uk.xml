    <unit id="=&gt;q80" name="=&gt;q80">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">160</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Let me drink in freakin' peace.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a81" name="=&gt;a81">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">162</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Can you not call me "bud"?&lt;end&gt;</source>
        <target state="new" />
      </segment>
