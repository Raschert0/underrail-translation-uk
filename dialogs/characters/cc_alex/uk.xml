      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">164</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He gives you an indifferent look.:: Aight, bud, not a problem.&lt;end&gt;</source>
