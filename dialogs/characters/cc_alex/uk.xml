      </segment>
    </unit>
    <unit id="=&gt;a66" name="=&gt;a66">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">132</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Where were the Bakers captured, again?&lt;end&gt;</source>
        <target state="new" />
      </segment>
