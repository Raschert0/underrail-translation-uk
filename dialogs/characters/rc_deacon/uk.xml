    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Show me what you have for sale. ::Barter.::&lt;end&gt;</source>
        <target state="needs-translation">Покажи мені, що у тебе є в продажу. ::Торгуй.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a10" name="=&gt;a10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm looking for Terry and Lora Baker, merchants from SGS. Have you seen them recently?&lt;end&gt;</source>
        <target state="needs-translation">Я шукаю Террі та Лору Бейкерів, торговців з SGS. Ти бачив їх останнім часом?&lt;end&gt;</target>
      </segment>
    </unit>
