      <segment state="translated">
        <source>Ah, a fresh face in town. Welcome to my little shop.&lt;end&gt;</source>
        <target state="needs-translation">Ах, нове обличчя в місті. Ласкаво просимо до моєї крамнички.&lt;end&gt;</target>
      </segment>
    </unit>
