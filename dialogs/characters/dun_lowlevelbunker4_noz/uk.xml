    <unit id="=&gt;q24" name="=&gt;q24">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">48</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yeah, uhm, those fiendish monsters. Ya sure you haven't heard of 'em before? Everybody knows about 'em.&lt;end&gt;</source>
        <target state="new" />
      </segment>
