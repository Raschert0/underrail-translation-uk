      </mda:metadata>
      <segment state="translated">
        <source>Busty woman? I... What in bloody hell are you tryin' to do here, $(context.player.Name). How dare you? How dare you!? Get away from me before I get really pissed off and strangle you with your own hands!&lt;end&gt;</source>
        <target state="new" />
