    </unit>
    <unit id="=&gt;a34" name="=&gt;a34">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Time to go, Maura.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q35" name="=&gt;q35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What do you have in mind?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a36" name="=&gt;a36">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">72</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave her be.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a37" name="=&gt;a37">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
