    <unit id="=&gt;a27" name="=&gt;a27">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">54</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I've unlocked your cell and the door to this room. You'll have to make a run to the vents in a room down the hall. In the vents you'll find a crack that leads up into the caves.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q28" name="=&gt;q28">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Pfff! Sounds risky... but I guess I'll take my chances. Better than rottin' in this place.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a29" name="=&gt;a29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
