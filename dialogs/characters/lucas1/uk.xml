    <unit id="=&gt;q33" name="=&gt;q33">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">66</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>It's just that I don't want us hauling all this ordnance back and forth because of a couple of thugs - or a rathound.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a34" name="=&gt;a34">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll see him if I get the chance.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q35" name="=&gt;q35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Thanks. &lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
