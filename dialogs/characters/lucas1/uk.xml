      </segment>
    </unit>
    <unit id="=&gt;q21" name="=&gt;q21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Dig: to get - to understand. Damn, $(context.player.Name), where've you been living all this time?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a22" name="=&gt;a22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
