<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\characters\cc_acidmessenger.txt" original="dialogs\characters\cc_acidmessenger.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>$(#Mister/Miss) $(context.player.Name)? I have a message for you.&lt;end&gt;</source>
        <target state="translated">$(#Пан/Пані) $(context.player.Name)? У мене є повідомлення для вас.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a2" name="=&gt;a2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Let's hear it.&lt;end&gt;</source>
        <target state="translated">Кажіть.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The man clears his throat.::&lt;end&gt;</source>
        <target state="translated">::Чоловік прокашлюється.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Archibald Knight, chief of Praetorian Security, hereby requests that you meet him in his office at the Praetorian Security headquarters. You are to see him as soon as possible.&lt;end&gt;</source>
        <target state="translated">Арчібальд Найт, начальник Praetorian Security, просить вас зустрітися з ним у його кабінеті в штаб-квартирі Praetorian Security. Ви повинні побачити його якнайшвидше.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a6" name="=&gt;a6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Is that all?&lt;end&gt;</source>
        <target state="translated">Це все?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>That is all.&lt;end&gt;</source>
        <target state="translated">Це все.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a8" name="=&gt;a8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Have a nice day.&lt;end&gt;</source>
        <target state="translated">Гарного дня.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Splendid. Invictus out!&lt;end&gt;</source>
        <target state="translated">Чудово. Інвіктус закінчив!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a10" name="=&gt;a10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Thank you. Here's a charon for your troubles. ::Offer him one charon.::&lt;end&gt;</source>
        <target state="translated">Дякую. Ось харон за ваші турботи. ::Запропонувати йому один харон.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Only one? ::He displays an expression of disgust.:: What a cheapskate! I'll pass.&lt;end&gt;</source>
        <target state="translated">Лише один? ::Він висловлює огиду.:: Який ти скупий! Я відмовлюся.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Suit yourself. Have a nice day.&lt;end&gt;</source>
        <target state="translated">Як хочеш. Гарного дня.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a13" name="=&gt;a13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Whatever, man. Goodbye.&lt;end&gt;</source>
        <target state="translated">Ну, як знаєш. Бувай.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Rupert Simmons, president of Coretech, hereby requests that you meet him in his office at the Coretech building. You are to see him as soon as possible.&lt;end&gt;</source>
        <target state="translated">Руперт Сіммонс, президент Coretech, просить вас зустрітися з ним у його кабінеті в будівлі Coretech. Ви повинні побачити його якнайшвидше.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Gunnar Edstrom, of JKK, hereby requests that you meet him in his office in the JKK headquarters. You are to see him as soon as possible.&lt;end&gt;</source>
        <target state="translated">Гуннар Едстром, з JKK, просить вас зустрітися з ним у його кабінеті в штаб-квартирі JKK. Ви повинні побачити його якнайшвидше.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a16" name="=&gt;a16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>A message for me? Well, I'm all ears...&lt;end&gt;</source>
        <target state="translated">Повідомлення для мене? Ну, уважно вас слухаю...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a17" name="=&gt;a17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Oh, joy! Can't wait to hear it.&lt;end&gt;</source>
        <target state="translated">О, яка радість! Не можу дочекатися, щоб почути його.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q18" name="=&gt;q18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Now off to Hardcore City Bar! Dominating!&lt;end&gt;</source>
        <target state="translated">Тепер до Хардкор Сіті Бар! Доміную!&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
