<?xml version='1.0' encoding='utf-8'?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\characters\jy_treasa.txt" original="dialogs\characters\jy_treasa.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I've seen nuthin'. I ain't even here.&lt;end&gt;</source>
        <target state="needs-translation">Я нічого не бачила. Навіть не тут була.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why... why did you kill that sorry sap?&lt;end&gt;</source>
        <target state="needs-translation">Чому... чому ти вбила того жалюгідного невдаху?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a3" name="=&gt;a3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>That's none of your business.&lt;end&gt;</source>
        <target state="needs-translation">Це не твоя справа.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You're damn right it isn't. As far as I'm concerned I was never here.&lt;end&gt;</source>
        <target state="needs-translation">Ти маєш рацію. Наскільки я пам'ятаю, мене тут ніколи не було.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a5" name="=&gt;a5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Dibs on the head!&lt;end&gt;</source>
        <target state="needs-translation">Забираю голову!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You're some kind of sicko, aren't you?&lt;end&gt;</source>
        <target state="needs-translation">Ти якийсь збоченець, чи що?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a7" name="=&gt;a7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>He owed some money to certain people. Poor man couldn't pay up.&lt;end&gt;</source>
        <target state="needs-translation">Він заборгував гроші певним людям. Бідний чоловік не зміг заплатити.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::She nods.:: Figures.&lt;end&gt;</source>
        <target state="needs-translation">::Вона киває.:: Зрозуміло.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Oh, don't worry. You'll be joining him presently. ::Attack Treasa.::&lt;end&gt;</source>
        <target state="needs-translation">О, не хвилюйся. Ти незабаром приєднаєшся до нього. ::Атакувати Треасу.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You and I got no damn business. Just stay the heck away from me and we good.&lt;end&gt;</source>
        <target state="needs-translation">Нам з тобою нема чого обговорювати. Просто тримайся від мене подалі, і все буде добре.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Mind your own business.&lt;end&gt;</source>
        <target state="needs-translation">Слідкуй за своїми справами.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Get lost.&lt;end&gt;</source>
        <target state="needs-translation">Забирайся.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Snooping's bad for your health, $(#jack/sister).&lt;end&gt;</source>
        <target state="needs-translation">Підслуховування шкідливе для вашого здоров'я, $(#jack/sister).&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
