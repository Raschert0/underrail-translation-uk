      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Water! Clean water here!&lt;end&gt;</source>
        <target state="needs-translation">Вода! Чиста вода тут!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Come 'n' get your clean water!&lt;end&gt;</source>
        <target state="needs-translation">Приходьте та беріть чисту воду!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Hey, want some water?&lt;end&gt;</source>
        <target state="needs-translation">Гей, хочете води?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>This water's been purified, no traces of dangerous heavy metals in it! Guaranteed!&lt;end&gt;</source>
        <target state="needs-translation">Ця вода очищена, в ній немає слідів небезпечних важких металів! Гарантовано!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Thirsty?&lt;end&gt;</source>
        <target state="needs-translation">Спраглий?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Man, this is tiring. I should take a sip...&lt;end&gt;</source>
        <target state="needs-translation">Та все це втомлює. Варто б зробити ковток…&lt;end&gt;</target>
      </segment>
    </unit>
