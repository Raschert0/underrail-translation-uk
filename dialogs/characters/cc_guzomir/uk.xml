        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You dig any of this?&lt;end&gt;</source>
        <target state="needs-translation">Ти розумієш це?&lt;end&gt;</target>
