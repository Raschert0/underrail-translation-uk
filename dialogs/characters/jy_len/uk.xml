<?xml version='1.0' encoding='utf-8'?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\characters\jy_len.txt" original="dialogs\characters\jy_len.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Welcome to my little shop, stranger. Lookin' for some weapons or armor?&lt;end&gt;</source>
        <target state="needs-translation">Ласкаво просимо до моєї крамнички, незнайомцю. Шукаєте зброю чи броню?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a3" name="=&gt;a3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Show me what you got. ::Barter.::&lt;end&gt;</source>
        <target state="needs-translation">Покажіть, що у вас є. ::Торгуйте.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a4" name="=&gt;a4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Merchants here only accept stygian coins? How do I get some of those?&lt;end&gt;</source>
        <target state="needs-translation">Торговці тут приймають лише стігійські монети? Як мені їх дістати?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Look for Colton at the docks. He can sell you charon.&lt;end&gt;</source>
        <target state="needs-translation">Пошукайте Колтона на Доках. Він може продати вам Харона.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a6" name="=&gt;a6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Would you happen to by any chance have an Armadillo class drill rotor circuit board?&lt;end&gt;</source>
        <target state="needs-translation">Ви не могли б випадково мати друковану плату свердлового ротора класу "Арміло"?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Nope. I mostly just sell weapons. Ya should hit the Depot or the docks for that stuff.&lt;end&gt;</source>
        <target state="needs-translation">Ні. Я здебільшого продаю зброю. Вам варто зайти на Склад або на Доки за цим.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a8" name="=&gt;a8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Where's the Depot?&lt;end&gt;</source>
        <target state="needs-translation">Де знаходиться Депо?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Just to the west, $(#jack/sis). Look for a slacker called Gort. He might 'ave what ya need.&lt;end&gt;</source>
        <target state="needs-translation">Трохи на захід, $(#jack/sis). Пошукайте ледачого Горта. Можливо, у нього є те, що вам потрібно.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a10" name="=&gt;a10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Where are the Docks?&lt;end&gt;</source>
        <target state="needs-translation">Де Доки?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>To the east, $(#jack/sis), ya can't miss it.&lt;end&gt;</source>
        <target state="needs-translation">На схід, $(#jack/sis), ви не пропустите.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Catch you later.&lt;end&gt;</source>
        <target state="needs-translation">Побачимось пізніше.&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
