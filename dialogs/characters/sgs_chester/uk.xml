      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">92</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Here. ::He hands you the coins.::

The ring.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a47" name="=&gt;a47">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">94</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Give him the gold ring.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a48" name="=&gt;a48">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">96</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Niiiiice. Here you go. ::Give him the gold ring.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
