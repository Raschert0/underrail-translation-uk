        <mda:meta type="pos_id">112</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I got rid of them all. You are safe now.&lt;end&gt;</source>
        <target state="needs-translation">Я позбувся їх усіх. Тепер ти в безпеці.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q57" name="=&gt;q57">
