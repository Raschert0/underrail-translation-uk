        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">136</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I'm on my own. They are still out there. Armed and dangerous.&lt;end&gt;</source>
        <target state="needs-translation">Я сам по собі. Вони все ще там. Озброєні та небезпечні.&lt;end&gt;</target>
