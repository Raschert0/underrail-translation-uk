        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">134</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>They are no longer out there. I got rid of them.&lt;end&gt;</source>
        <target state="needs-translation">Їх більше немає там. Я позбувся їх.&lt;end&gt;</target>
