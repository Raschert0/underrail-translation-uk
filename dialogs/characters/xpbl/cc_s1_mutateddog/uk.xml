    <unit id="=&gt;a10" name="=&gt;a10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Try to pet the dog.::&lt;end&gt;</source>
        <target state="needs-translation">::Спробуй погладити собаку.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::As the shadow of your claw reaches the dog, it moves its head away. Using both paws, the dog now steps on to the food plate.::&lt;end&gt;</source>
        <target state="needs-translation">::Коли тінь твоєї кігті досягає собаки, він відводить голову. Використовуючи обидві лапи, собака тепер застрибує на тарілку.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
