    <unit id="=&gt;a28" name="=&gt;a28">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hhhhhhooooop... Hhhoooooppp.&lt;end&gt;</source>
        <target state="needs-translation">Хххххооооп... Хххоооопп.&lt;end&gt;</target>
      </segment>
