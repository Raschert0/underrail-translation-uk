      </mda:metadata>
      <segment state="translated">
        <source>::Wheeze:: Do what Juraj told you to. Shoo...&lt;end&gt;</source>
        <target state="needs-translation">::Задихається:: Роби те, що тобі сказав Юрай. Геть...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
