      </mda:metadata>
      <segment state="translated">
        <source>That old fool never stood a chance against me, hah!&lt;end&gt;</source>
        <target state="needs-translation">Цей старий дурень ніколи не мав шансів проти мене, ха-ха!&lt;end&gt;</target>
      </segment>
    </unit>
