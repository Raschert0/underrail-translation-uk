      </mda:metadata>
      <segment state="translated">
        <source>Hurry, hurry. ::Wheeze:: My reward awaits!&lt;end&gt;</source>
        <target state="needs-translation">Поспішай, поспішай. ::Задихається:: Моя нагорода чекає!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
