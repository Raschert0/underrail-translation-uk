        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>This is my corner. ::Waves you off.::&lt;end&gt;</source>
        <target state="needs-translation">Це мій куток. ::Махає рукою, щоб ти пішов.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
