        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tchort guide you.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a29" name="=&gt;a29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">58</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>See you later, Prevlic.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
