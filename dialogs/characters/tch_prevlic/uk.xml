    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Rassophore Prevlic quietly looks at you, not saying a single word. You somehow suspect that his facial expression is just as emotionless as his mask is.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a4" name="=&gt;a4">
      <mda:metadata>
