      </mda:metadata>
      <segment state="translated">
        <source>Hi, I'm $(context.player.Name). Who are you?&lt;end&gt;</source>
        <target state="needs-translation">Привіт, я $(context.player.Name). А ви хто?&lt;end&gt;</target>
      </segment>
    </unit>
