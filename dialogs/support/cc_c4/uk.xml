    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Foundry is open again. That's good news.&lt;end&gt;</source>
        <target state="needs-translation">Ливарня знову відкрита. Це хороша новина.&lt;end&gt;</target>
      </segment>
