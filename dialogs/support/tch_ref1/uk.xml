        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>$(context.player.Name), what brings you here? Er... it's probably hunger. Stupid question...&lt;end&gt;</source>
        <target state="needs-translation">$(context.player.Name), що привело тебе сюди? Е-е... мабуть, голод. Дурне питання...&lt;end&gt;</target>
      </segment>
