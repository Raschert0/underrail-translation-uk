    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I ate so much I can't move!&lt;end&gt;</source>
        <target state="needs-translation">Я наївся так, що не можу поворухнутися!&lt;end&gt;</target>
