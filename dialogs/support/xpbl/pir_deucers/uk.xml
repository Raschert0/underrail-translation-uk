    <unit id="=&gt;q30" name="=&gt;q30">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">60</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Only d' sea knows how many more folks like Todd're down dere.&lt;end&gt;</source>
        <target state="needs-translation">Тільки море знає, скільки ще таких, як Тодд, там внизу.&lt;end&gt;</target>
