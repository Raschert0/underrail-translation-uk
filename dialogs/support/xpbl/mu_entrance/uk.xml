        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">110</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Say nothing, just stare.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a56" name="=&gt;a56">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">112</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::[Intelligence]:: Don't you understand? The grotituous contrametulation is looming and this conversation is taking away precious time!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q57" name="=&gt;q57">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">114</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Gro-whaaaaa?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a58" name="=&gt;a58">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">116</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>*Grotituous*. *contrametulation*, man: The underperulence of trychiatric post-junksoid stillnatious carussoilocity.&lt;end&gt;</source>
