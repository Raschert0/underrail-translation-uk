        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">86</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He spits aside.::

Get outta 'ere or I'm gonna turn ya dead this instant, I swear. Dead!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q44" name="=&gt;q44">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">88</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a45" name="=&gt;a45">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">90</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I was only joking! Don't you have a sense of humor?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q46" name="=&gt;q46">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">92</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You are now talking to the barrel of his gun.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a47" name="=&gt;a47">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">94</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Fine. I'm leaving.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a48" name="=&gt;a48">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">96</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Leave without saying a word.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a49" name="=&gt;a49">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">98</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Let me in or I'll make your face even less recognizable.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q50" name="=&gt;q50">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">100</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why-- Eat lead!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a51" name="=&gt;a51">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">102</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Fight!::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a52" name="=&gt;a52">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">104</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm going in whether you freaks like it or not. ::Attack!::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a53" name="=&gt;a53">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">106</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Just warning you.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q54" name="=&gt;q54">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">108</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
