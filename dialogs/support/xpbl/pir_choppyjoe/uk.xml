  <file id="dialogs\support\xpbl\pir_choppyjoe.txt" original="dialogs\support\xpbl\pir_choppyjoe.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Defen' d' port!&lt;end&gt;</source>
        <target state="needs-translation">Захищайте порт!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Ye showed it to Flinga real gewd.&lt;end&gt;</source>
        <target state="needs-translation">Ти показав це Флінзі дуже добре.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>It ain' done till it's chopped up real gewd, banga, real gewd.&lt;end&gt;</source>
        <target state="needs-translation">Воно не зроблено, поки його не посічено дуже добре, банга, дуже добре.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Chop, chop!&lt;end&gt;</source>
        <target state="needs-translation">Рубай, рубай!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Dis sipha gonna be gewd. Mmm-hm!&lt;end&gt;</source>
        <target state="needs-translation">Ця сифа буде хорошою. Ммм-хм!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Didja know I once spent twenty-three hours doin' nuthin' but choppin'?&lt;end&gt;</source>
        <target state="needs-translation">Чи знав ти, що я колись провів двадцять три години, просто рубаючи?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Music goes well wit' *choppin'*!&lt;end&gt;</source>
        <target state="needs-translation">Музика добре поєднується з *рубанням*!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>'Sup, banga?&lt;end&gt;</source>
        <target state="needs-translation">Що нового, банга?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Choppin' is life.&lt;end&gt;</source>
        <target state="needs-translation">Рубання – це життя.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Need sumthin' chopped up?&lt;end&gt;</source>
        <target state="needs-translation">Потрібно щось посікти?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I keep me 'chete shavin' sharp. ::Grins.::&lt;end&gt;</source>
        <target state="needs-translation">Я тримаю свій ніж гострим. ::Посміхається.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I've been hearin' a lot about yer deeds, banga. How 'about a brew once I'm done choppin'?&lt;end&gt;</source>
        <target state="needs-translation">Я чув багато про твої вчинки, банга. Як щодо пива, коли я закінчу рубати?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Shame 'bout Razor. ::Shakes his head.:: Taught me sum slickin' blade maintenance tricks.&lt;end&gt;</source>
        <target state="needs-translation">Шкода про Рейзора. ::Хитає головою.:: Він навчив мене кільком хитрим прийомам догляду за лезом.&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
