    <unit id="=&gt;a7" name="=&gt;a7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Let's get back to the camp.&lt;end&gt;</source>
        <target state="needs-translation">Повернімося до табору.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He nods.::&lt;end&gt;</source>
        <target state="needs-translation">::Він киває.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Sail to Black Sea Expedition camp.::&lt;end&gt;</source>
        <target state="needs-translation">::Відплисти до табору експедиції Чорного моря.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;a10" name="=&gt;a10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm ready. Let's go to Core City.&lt;end&gt;</source>
        <target state="needs-translation">Я готовий. Ходімо до Центрального Міста.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm going to need to charge you for the trip. Chief's orders.&lt;end&gt;</source>
        <target state="needs-translation">Мені потрібно стягнути з вас плату за поїздку. Наказ Головного.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Makes sense. How much?&lt;end&gt;</source>
        <target state="needs-translation">Зрозуміло. Скільки?::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Fifty stygian coins to Core City and back. It's to cover for the trip expenses, plain and simple. &lt;end&gt;</source>
        <target state="needs-translation">П'ятдесят стигійських монет до Центрального Міста і назад. Це щоб покрити витрати на поїздку, просто і зрозуміло.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a15" name="=&gt;a15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Here you go. ::Give him 50 stygian coins.::&lt;end&gt;</source>
        <target state="needs-translation">Ось, тримайте. ::Дайте йому 50 стигійських монет.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He counts the coins and nods.::

Hold tight - and watch that antenna.&lt;end&gt;</source>
        <target state="needs-translation">::Він перераховує монети і киває.::

Тримайтеся міцно - і бережіть антену.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;a17" name="=&gt;a17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Sail to Core City.::&lt;end&gt;</source>
        <target state="needs-translation">::Відплисти до Центрального Міста.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;a18" name="=&gt;a18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Actually, I got something to do first.&lt;end&gt;</source>
        <target state="needs-translation">Насправді, мені спочатку треба щось зробити.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q19" name="=&gt;q19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He nods.:: I'll be around if you need me.&lt;end&gt;</source>
        <target state="needs-translation">::Він киває.:: Я буду поруч, якщо вам знадобиться.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;a20" name="=&gt;a20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Can we, you know, work out some kind of a deal?&lt;end&gt;</source>
        <target state="needs-translation">Чи можемо ми, знаєте, домовитися про якусь угоду?::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q21" name="=&gt;q21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm afraid not. Orders. &lt;end&gt;</source>
        <target state="needs-translation">Боюся, ні. Наказ.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;a22" name="=&gt;a22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">44</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Can't you just deduce it from my pay?&lt;end&gt;</source>
        <target state="needs-translation">Хіба ви не можете просто відрахувати це з моєї зарплати?::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q23" name="=&gt;q23">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">46</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm afraid not. Cash only. &lt;end&gt;</source>
        <target state="needs-translation">Боюся, ні. Тільки готівка.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;a24" name="=&gt;a24">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">48</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Preposterous!&lt;end&gt;</source>
        <target state="needs-translation">Нечувано!::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q25" name="=&gt;q25">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">50</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He nods.:: That's fifty stygian coins.&lt;end&gt;</source>
        <target state="needs-translation">::Він киває.:: Це п'ятдесят стигійських монет.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;a26" name="=&gt;a26">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">52</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hey, can you take me somewhere other than Core City?&lt;end&gt;</source>
        <target state="needs-translation">Гей, чи можете ви відвезти мене кудись, окрім Центрального Міста?::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q27" name="=&gt;q27">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">54</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Core City only, $(context.player.Name). Chief's orders.&lt;end&gt;</source>
        <target state="needs-translation">Тільки Центральне Місто, $(context.player.Name). Наказ Головного.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q28" name="=&gt;q28">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>But even if I were allowed otherwise, I don't know these Southern waterways well enough anyway.&lt;end&gt;</source>
        <target state="needs-translation">Але навіть якщо б мені було дозволено інакше, я все одно не знаю ці південні водні шляхи досить добре.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;a29" name="=&gt;a29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">58</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm good for now.&lt;end&gt;</source>
        <target state="needs-translation">Я поки що добре.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q30" name="=&gt;q30">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">60</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Don't take too long. We have to get back to the camp soon.&lt;end&gt;</source>
        <target state="needs-translation">Не затримуйтеся. Ми повинні повернутися до табору незабаром.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q31" name="=&gt;q31">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">62</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We have to secure the professor.&lt;end&gt;</source>
        <target state="needs-translation">Ми повинні забезпечити безпеку професора.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;a32" name="=&gt;a32">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">64</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Already got a ride.&lt;end&gt;</source>
        <target state="needs-translation">Вже знайшов транспорт.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q33" name="=&gt;q33">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">66</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Ready to go back?&lt;end&gt;</source>
        <target state="needs-translation">Готовий повертатися?::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q34" name="=&gt;q34">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He greets you with a nod.:: &lt;end&gt;</source>
        <target state="needs-translation">::Він вітає вас кивком.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q35" name="=&gt;q35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We gotta make this round quick, $(context.player.Name). Situation's critical.&lt;end&gt;</source>
        <target state="needs-translation">Ми повинні зробити цей обхід швидко, $(context.player.Name). Ситуація критична.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q36" name="=&gt;q36">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">72</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We've lost far too many troopers, $(context.player.Name). If this continues &lt;end&gt;</source>
        <target state="needs-translation">Ми втратили занадто багато солдатів, $(context.player.Name). Якщо це триватиме &lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q37" name="=&gt;q37">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">74</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>the chief will most likely transfer all jet skiers inland to defend the camp.&lt;end&gt;</source>
        <target state="needs-translation">головний, ймовірно, переведе всіх гідроциклістів на сушу, щоб захистити табір.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q38" name="=&gt;q38">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">76</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>

So make the trips count.&lt;end&gt;</source>
        <target state="needs-translation">Тож робіть поїздки корисними.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q39" name="=&gt;q39">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">78</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>we'll most likely have to stay in the camp and maintain defenses.&lt;end&gt;</source>
        <target state="needs-translation">ми, ймовірно, доведеться залишатися в таборі та підтримувати оборону.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q40" name="=&gt;q40">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">80</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We're low on&lt;end&gt;</source>
        <target state="needs-translation">У нас мало&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q41" name="=&gt;q41">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">82</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q42" name="=&gt;q42">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">84</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>supplies, $(context.player.Name), so better stock up over there. I'll be loaded too, so expect a slow trip back.&lt;end&gt;</source>
        <target state="needs-translation">припасів, $(context.player.Name), тому краще запасіться там. Я теж буду завантажений, тому очікуйте повільну поїздку назад.::end</target>
      </segment>
    </unit>
    <unit id="=&gt;q43" name="=&gt;q43">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">86</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>certain &lt;end&gt;</source>
        <target state="needs-translation">певні &lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q44" name="=&gt;q44">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">88</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Another round?&lt;end&gt;</source>
        <target state="needs-translation">Ще один обхід?::end</target>
      </segment>
    </unit>
