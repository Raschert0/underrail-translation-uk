    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We better hit d' waves now. Good luck on yer way back, mate.&lt;end&gt;</source>
        <target state="needs-translation">Нам краще вирушити в море зараз. Удачі на шляху назад, друже.&lt;end&gt;</target>
      </segment>
    </unit>
