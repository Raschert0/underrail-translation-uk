        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You can't take it anymore. Blink!::&lt;end&gt;</source>
        <target state="needs-translation">::Ви більше не можете це витримати. Моргайте!::&lt;end&gt;</target>
      </segment>
