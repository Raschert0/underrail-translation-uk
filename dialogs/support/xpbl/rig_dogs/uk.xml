    <unit id="=&gt;q18" name="=&gt;q18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The dog turns its head and calmly walks away.::&lt;end&gt;</source>
        <target state="needs-translation">::Собака повертає голову і спокійно йде геть.::&lt;end&gt;</target>
      </segment>
