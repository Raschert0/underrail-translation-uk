    <unit id="=&gt;q20" name="=&gt;q20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::As soon as you open your eyes again you see the animal pouncing at you.::&lt;end&gt;</source>
        <target state="needs-translation">::Щойно ви знову відкриєте очі, ви побачите, як тварина накидається на вас.::&lt;end&gt;</target>
      </segment>
    </unit>
