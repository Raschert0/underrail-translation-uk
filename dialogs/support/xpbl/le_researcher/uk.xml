    <unit id="=&gt;q19" name="=&gt;q19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Are you one of the new sec-troopers?&lt;end&gt;</source>
        <target state="needs-translation">Ви один із нових військових?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q20" name="=&gt;q20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Any news on the blockade?&lt;end&gt;</source>
        <target state="needs-translation">Які новини щодо блокади?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q21" name="=&gt;q21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Has the blockade really been lifted?&lt;end&gt;</source>
        <target state="needs-translation">Блокаду справді зняли?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q22" name="=&gt;q22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">44</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Don't touch any of the relics, please. They're *very* old and fragile.&lt;end&gt;</source>
        <target state="needs-translation">Будь ласка, не торкайтеся реліквій. Вони *дуже* старі та крихкі.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q23" name="=&gt;q23">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">46</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>What's a... "pipeworker," actually?&lt;end&gt;</source>
        <target state="needs-translation">Що таке... "трубопровідник", власне?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q24" name="=&gt;q24">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">48</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
