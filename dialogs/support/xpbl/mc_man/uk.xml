<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\support\xpbl\mc_man.txt" original="dialogs\support\xpbl\mc_man.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Death lives here. Welcome to the morgue, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Смерть живе тут. Ласкаво просимо до моргу, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a2" name="=&gt;a2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>But I have not chosen death...&lt;end&gt;</source>
        <target state="needs-translation">Але я не вибрав смерть...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>No... you chose to ignore him.&lt;end&gt;</source>
        <target state="needs-translation">Ні... ти обрав проігнорувати її.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a5" name="=&gt;a5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Who is he?&lt;end&gt;</source>
        <target state="needs-translation">Хто вона?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Dr. Mason. Everyone died; no one lived. Yet he is unable to settle. 

It's his mind, you see: It is exceptional.&lt;end&gt;</source>
        <target state="needs-translation">Доктор Мейсон. Всі померли; ніхто не вижив. Проте він не може заспокоїтися.

Це його розум, розумієте: він винятковий.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>He can reach other minds, minds like yours. You are the first to approach him in a long, long time, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="translated">Він здатен торкатись інших свідомостей — таких як ваша. Ви $(#перший/перша), хто наблизився до нього за дуже, дуже довгий час, $(#пане/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a8" name="=&gt;a8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Who are you?&lt;end&gt;</source>
        <target state="needs-translation">Хто ви?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I am but a vessel, a Servant - not his, but yours. I am the link.&lt;end&gt;</source>
        <target state="needs-translation">Я лише посудина, Слуга – не його, а ваш. Я – зв'язок.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Even though you ignored him, a link between you two has been established.&lt;end&gt;</source>
        <target state="needs-translation">Навіть незважаючи на те, що ви його проігнорували, між вами двома встановлено зв'язок.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You understand him. A strong link between you two has been established.&lt;end&gt;</source>
        <target state="needs-translation">Ви розумієте його. Між вами двома встановлено міцний зв'язок.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>A link between you two has been established despite you inconsistent behavior.&lt;end&gt;</source>
        <target state="needs-translation">Між вами двома встановлено зв'язок, незважаючи на вашу непослідовну поведінку.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a13" name="=&gt;a13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why did I get those visions?&lt;end&gt;</source>
        <target state="needs-translation">Чому я бачив ці видіння?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Communication. He can only reach you through your mind, and only through emotions.&lt;end&gt;</source>
        <target state="needs-translation">Спілкування. Він може досягти вас лише через ваш розум і лише через емоції.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a15" name="=&gt;a15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why me?&lt;end&gt;</source>
        <target state="needs-translation">Чому я?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>There is no one else, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Іншого немає, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a17" name="=&gt;a17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What about the other Servants?&lt;end&gt;</source>
        <target state="needs-translation">Що щодо інших Слуг?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q18" name="=&gt;q18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>They are just like me. I am simply the one closest to him.&lt;end&gt;</source>
        <target state="needs-translation">Вони такі ж, як і я. Я просто той, хто найближчий до нього.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a19" name="=&gt;a19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What now?&lt;end&gt;</source>
        <target state="needs-translation">Що далі?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q20" name="=&gt;q20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Resolution... $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Вирішення... $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a21" name="=&gt;a21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I am ready.&lt;end&gt;</source>
        <target state="needs-translation">Я готовий.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q22" name="=&gt;q22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">44</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>He desires... yearns for resolution. He chose death a long time ago. &lt;end&gt;</source>
        <target state="needs-translation">Він прагне... жадає вирішення. Він обрав смерть давно. &lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q23" name="=&gt;q23">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">46</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You understand him fully. You can help him.&lt;end&gt;</source>
        <target state="needs-translation">Ви повністю розумієте його. Ви можете йому допомогти.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q24" name="=&gt;q24">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">48</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a25" name="=&gt;a25">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">50</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why would I want to help him?&lt;end&gt;</source>
        <target state="needs-translation">Чому я маю йому допомагати?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q26" name="=&gt;q26">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">52</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You have no other options. The link is strong enough, and he won't let you leave without resolution.&lt;end&gt;</source>
        <target state="needs-translation">У вас немає іншого вибору. Зв'язок достатньо міцний, і він не дозволить вам піти без вирішення.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q27" name="=&gt;q27">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">54</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q28" name="=&gt;q28">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You have no other options. The link is strong, and he won't let you leave without resolution.&lt;end&gt;</source>
        <target state="needs-translation">У вас немає іншого вибору. Зв'язок міцний, і він не дозволить вам піти без вирішення.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a29" name="=&gt;a29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">58</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What is the reason I am able to help him?&lt;end&gt;</source>
        <target state="needs-translation">Чому я можу йому допомогти?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q30" name="=&gt;q30">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">60</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You can endure it. You've experienced enough.&lt;end&gt;</source>
        <target state="needs-translation">Ви можете це витримати. Ви достатньо пережили.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a31" name="=&gt;a31">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">62</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I want to help him.&lt;end&gt;</source>
        <target state="needs-translation">Я хочу йому допомогти.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a32" name="=&gt;a32">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">64</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I am not doing this.&lt;end&gt;</source>
        <target state="needs-translation">Я цього не робитиму.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q33" name="=&gt;q33">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">66</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Please listen, $(#sir/ma'am). &lt;end&gt;</source>
        <target state="needs-translation">Будь ласка, послухайте, $(#sir/ma'am). &lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q34" name="=&gt;q34">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I will lead you into his chamber. He will help you with the rest, $(#sir/ma'am). And when you leave that chamber, you will emerge different.&lt;end&gt;</source>
        <target state="needs-translation">Я проведу вас до його кімнати. Він допоможе вам з рештою, $(#sir/ma'am). І коли ви покинете цю кімнату, ви вийдете іншими.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q35" name="=&gt;q35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>

Finally...&lt;end&gt;</source>
        <target state="needs-translation">Нарешті...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a36" name="=&gt;a36">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">72</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Resolution.::&lt;end&gt;</source>
        <target state="needs-translation">::Вирішення.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q37" name="=&gt;q37">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">74</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a38" name="=&gt;a38">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">76</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What actually determines whether I can help him or not?&lt;end&gt;</source>
        <target state="needs-translation">Що саме визначає, чи зможу я йому допомогти чи ні?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q39" name="=&gt;q39">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">78</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Upon entering the chamber your mind will be exposed fully to him and to all that he is. And his presence is powerful. &lt;end&gt;</source>
        <target state="needs-translation">Увійшовши до кімнати, ваш розум буде повністю відкритий для нього та для всього, чим він є. І його присутність потужна. &lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q40" name="=&gt;q40">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">80</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You do not understand him sufficiently - you have not been conditioned. Whether you will endure or not... is something I cannot answer. And on that depends whether you will be able to help him or not.&lt;end&gt;</source>
        <target state="needs-translation">Ви недостатньо його розумієте – вас не підготували. Чи витримаєте ви чи ні... цього я не можу відповісти. І від цього залежить, чи зможете ви йому допомогти чи ні.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q41" name="=&gt;q41">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">82</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You understand him already - you have been conditioned sufficiently. You will be able to endure it, $(#sir/ma'am). And you will be able to help him.&lt;end&gt;</source>
        <target state="needs-translation">Ви вже розумієте його – вас достатньо підготували. Ви зможете це витримати, $(#sir/ma'am). І ви зможете йому допомогти.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a42" name="=&gt;a42">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">84</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What is going to happen to me in there?&lt;end&gt;</source>
        <target state="needs-translation">Що зі мною станеться там?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q43" name="=&gt;q43">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">86</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Whatever must happen.&lt;end&gt;</source>
        <target state="needs-translation">Те, що має статися.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a44" name="=&gt;a44">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">88</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Let's do this. I'm going in.&lt;end&gt;</source>
        <target state="needs-translation">Давайте зробимо це. Я йду.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q45" name="=&gt;q45">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">90</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Finally...&lt;end&gt;</source>
        <target state="needs-translation">Нарешті...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a46" name="=&gt;a46">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">92</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::[Will]:: No, you're playing with my mind. I don't want to go in there. I don't!&lt;end&gt;</source>
        <target state="needs-translation">::[Воля]:: Ні, ти граєшся з моїм розумом. Я не хочу туди йти. Я не хочу!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q47" name="=&gt;q47">
