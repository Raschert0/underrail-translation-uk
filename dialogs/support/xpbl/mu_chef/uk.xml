      </mda:metadata>
      <segment state="translated">
        <source>Ya already got yer ration. ::wheeze:: &lt;end&gt;</source>
        <target state="needs-translation">У тебе вже є твоя пайка. ::Хрип:: &lt;end&gt;</target>
