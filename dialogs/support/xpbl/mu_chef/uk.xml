      </mda:metadata>
      <segment state="translated">
        <source>We may have decayed on the outside, but you... ::wheeze::&lt;end&gt;</source>
        <target state="needs-translation">Ми, можливо, і згнили зовні, але ти... ::Хрип::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Keep walkin'. ::wheeze::&lt;end&gt;</source>
        <target state="needs-translation">Продовжуй йти. ::Хрип::&lt;end&gt;</target>
