  <file id="dialogs\support\xpbl\cc_pz_jetguard.txt" original="dialogs\support\xpbl\cc_pz_jetguard.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The marine raises his hand and signals you to stop.::

Hold it. The port is off-limits to unauthorized personnel.&lt;end&gt;</source>
        <target state="needs-translation">::Морпіх піднімає руку і дає тобі знак зупинитися.::

Стій. Порт закритий для неавторизованого персоналу.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a3" name="=&gt;a3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Name's $(context.player.Name).&lt;end&gt;</source>
        <target state="needs-translation">Мене звати $(context.player.Name).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He points a handheld scanner at your jet ski; red light reflects off his goggles.::

&lt;end&gt;</source>
        <target state="needs-translation">::Він направляє портативний сканер на твій гідроцикл; червоне світло відбивається від його окулярів.::

&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm sorry, Corporal, but you're going to have to see Private Lloyd at the warehouse entrance, over at the civilian dock. This entrance is for authorized vessels only.&lt;end&gt;</source>
        <target state="needs-translation">Вибачте, капрале, але вам доведеться звернутися до приватного Ллойда на складі біля цивільного причалу. Цей вхід призначений лише для авторизованих суден.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a7" name="=&gt;a7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>And my vessel is not authorized?&lt;end&gt;</source>
        <target state="needs-translation">І моє судно не авторизоване?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>No, $(#sir/ma'am). Not according to the scanner.&lt;end&gt;</source>
        <target state="needs-translation">Ні, $(#sir/ma'am). Не за даними сканера.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm Corporal $(context.player.Name).&lt;end&gt;</source>
        <target state="needs-translation">Я капрал $(context.player.Name).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a11" name="=&gt;a11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>This has got to be some kind of mistake.&lt;end&gt;</source>
        <target state="needs-translation">Це, мабуть, якась помилка.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>If you're not in the system, you're not docking here. You should know this, Corporal.&lt;end&gt;</source>
        <target state="needs-translation">Якщо тебе немає в системі, ти не можеш швартуватися тут. Ти повинен це знати, капрале.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a13" name="=&gt;a13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>But I was allowed to pass just a few days ago on this very jet ski.&lt;end&gt;</source>
        <target state="needs-translation">Але мені дозволили пройти тут кілька днів тому на цьому ж гідроциклі.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Then you were authorized to dock on that day. For today you aren't. Simple as that. 

Now please, Corporal, go speak with Private Lloyd at the warehouse entrance and hopefully he'll be able to refer you to someone who can help you.&lt;end&gt;</source>
        <target state="needs-translation">Тоді вам було дозволено пристикуватися того дня. Сьогодні ви не можете. Все просто.

Тепер, будь ласка, капрале, зверніться до приватного Ллойда біля входу на склад, і, сподіваюся, він зможе направити вас до когось, хто зможе вам допомогти.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a15" name="=&gt;a15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll get going then.&lt;end&gt;</source>
        <target state="needs-translation">Тоді я піду.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>No argument: You're not authorized; you cannot dock.&lt;end&gt;</source>
        <target state="needs-translation">Немає дозволу; ви не можете пристикуватися.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q17" name="=&gt;q17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You're not authorized to dock here. Please turn around. Thank you.&lt;end&gt;</source>
        <target state="needs-translation">Вам не дозволено пристикуватися тут. Будь ласка, поверніться. Дякую.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a18" name="=&gt;a18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>This is where they told me to dock.&lt;end&gt;</source>
        <target state="needs-translation">Тут мені сказали пристикуватися.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a19" name="=&gt;a19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What is this place?&lt;end&gt;</source>
        <target state="needs-translation">Що це за місце?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q20" name="=&gt;q20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>This is the entrance to Port Zenith, $(#sir/ma'am). Authorized vessels only.&lt;end&gt;</source>
        <target state="needs-translation">Це вхід до Порту Зеніт, $(#sir/ma'am). Лише для авторизованих суден.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q21" name="=&gt;q21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q22" name="=&gt;q22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">44</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What did I tell you? Turn around your vessel and leave.&lt;end&gt;</source>
        <target state="needs-translation">Що я вам казав? Розверніть свій апарат і йдіть.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a23" name="=&gt;a23">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">46</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>My bad. Goodbye.&lt;end&gt;</source>
        <target state="needs-translation">Вибачте. До побачення.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q24" name="=&gt;q24">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">48</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q25" name="=&gt;q25">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">50</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q26" name="=&gt;q26">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">52</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You may not dock here, Corporal.&lt;end&gt;</source>
        <target state="needs-translation">Вам не дозволено швартуватися тут, Корпорале.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q27" name="=&gt;q27">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">54</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He points his rifle at you.::

Hands up! Now!&lt;end&gt;</source>
        <target state="needs-translation">::Він наводить на вас рушницю.::

Руки вгору! Зараз!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a28" name="=&gt;a28">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Wait, wait! I'm one of you guys. I'm Corporal $(context.player.Name).&lt;end&gt;</source>
        <target state="needs-translation">Зачекайте, зачекайте! Я один з вас. Я капрал $(context.player.Name).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q29" name="=&gt;q29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">58</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yeah, right! &lt;end&gt;</source>
        <target state="needs-translation">Та ні, звісно! &lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q30" name="=&gt;q30">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">60</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Stay still - you're coming with me!

::He speaks into his radio.:: Zenith Command, this is Jay-Seven-Five...&lt;end&gt;</source>
        <target state="needs-translation">Стійте на місці - ви йдете зі мною!

::Він говорить у рацію.:: Командування Зеніт, це Джей-Сім-П'ять...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a31" name="=&gt;a31">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">62</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Listen to me!&lt;end&gt;</source>
        <target state="needs-translation">Послухайте мене!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q32" name="=&gt;q32">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">64</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>...I'm detaining a suspicious person. Will need assistance, over.&lt;end&gt;</source>
        <target state="needs-translation">...Я затримую підозрілу особу. Потрібна допомога, перевірте.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a33" name="=&gt;a33">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">66</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Resist arrest.::&lt;end&gt;</source>
        <target state="needs-translation">::Чиніть опір арешту.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a34" name="=&gt;a34">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Resist arrest.::&lt;end&gt;</source>
        <target state="needs-translation">::Чиніть опір арешту.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a35" name="=&gt;a35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Resist arrest.::&lt;end&gt;</source>
        <target state="needs-translation">::Опір арешту.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a36" name="=&gt;a36">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">72</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why? I didn't do anything wrong.&lt;end&gt;</source>
        <target state="needs-translation">Чому? Я нічого не зробив не так.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a37" name="=&gt;a37">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">74</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Raise your hands.:: What's going on?&lt;end&gt;</source>
        <target state="needs-translation">::Підніміть руки.:: Що відбувається?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a38" name="=&gt;a38">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">76</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Fight!::&lt;end&gt;</source>
        <target state="needs-translation">::Бій!::&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
