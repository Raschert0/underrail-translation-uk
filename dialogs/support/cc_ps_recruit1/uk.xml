      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Come on, be a man - you can do this!&lt;end&gt;</source>
        <target state="needs-translation">Ну ж бо, будь чоловіком - ти можеш це зробити!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>One, two, three, four...&lt;end&gt;</source>
        <target state="needs-translation">Один, два, три, чотири...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
