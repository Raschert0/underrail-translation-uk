      </mda:metadata>
      <segment state="translated">
        <source>Does he really have to yell at us like that?&lt;end&gt;</source>
        <target state="needs-translation">Він дійсно повинен на нас кричати?&lt;end&gt;</target>
      </segment>
    </unit>
