    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>He can call me a dirtbag all he wants, but I'll show him!&lt;end&gt;</source>
        <target state="needs-translation">Він може називати мене покидьком, скільки завгодно, але я йому покажу!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm harcdcore! I dominate! I can do this!&lt;end&gt;</source>
        <target state="needs-translation">Я хардкорний! Я доміную! Я можу це зробити!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Not going back to the Zone! I can do better than that! I know it!&lt;end&gt;</source>
        <target state="needs-translation">Не повернуся до Зони! Я можу зробити краще, ніж це! Я знаю це!&lt;end&gt;</target>
      </segment>
