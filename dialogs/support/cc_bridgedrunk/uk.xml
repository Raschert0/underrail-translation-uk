        <source>I'd say it's pretty darn good.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a35" name="=&gt;a35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>It's mushroom brew. Just like any other brew, I guess.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a36" name="=&gt;a36">
      <mda:metadata>
