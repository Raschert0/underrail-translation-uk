    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The Faceless could attack at any moment!&lt;end&gt;</source>
        <target state="needs-translation">Безликі можуть напасти будь-якої миті!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Please move. This area is not safe!&lt;end&gt;</source>
        <target state="needs-translation">Будь ласка, розійдіться. Тут небезпечно!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You derailed zoner...&lt;end&gt;</source>
        <target state="needs-translation">Ти зійшов зі шляху, зонер…&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>If you have a death wish, that's fine, just stop distracting me!&lt;end&gt;</source>
        <target state="needs-translation">Якщо у вас є смертельні бажання, гаразд, просто не відволікайте мене!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Those freaks are gonna taste our lead.&lt;end&gt;</source>
        <target state="needs-translation">Цих покидьків чекає свинець.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We're holding the line here.&lt;end&gt;</source>
        <target state="needs-translation">Ми тримаємо тут оборону.&lt;end&gt;</target>
      </segment>
