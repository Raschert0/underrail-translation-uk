<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\support\up_scavengergoaround.txt" original="dialogs\support\up_scavengergoaround.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Hey, $(#caveman/cavewoman), ya can't go downstairs.&lt;end&gt;</source>
        <target state="needs-translation">Гей, $(#печерна людина/печерна жінка), ти не можеш спускатися вниз.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a3" name="=&gt;a3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>What's down there?&lt;end&gt;</source>
        <target state="needs-translation">Що там внизу?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Pain if ya don't stay away.&lt;end&gt;</source>
        <target state="needs-translation">Біль, якщо ти не будеш триматися подалі.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a5" name="=&gt;a5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>You can't stop me, woman. I go where I please.&lt;end&gt;</source>
        <target state="needs-translation">Ти не можеш мене зупинити, жінко. Я йду куди заманеться.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Oh, I can. Take one step down those stairs and I'll turn ya into a pancake. Dig?&lt;end&gt;</source>
        <target state="needs-translation">О, можу. Зроби один крок вниз по цих сходах, і я перетворю тебе на млинець. Зрозуміло?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a7" name="=&gt;a7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Dig.&lt;end&gt;</source>
        <target state="needs-translation">Зрозуміло.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Good...&lt;end&gt;</source>
        <target state="needs-translation">Добре...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I. Go. Where. I. Please. ::Attack!::&lt;end&gt;</source>
        <target state="needs-translation">Я. Йду. Куди. Я. Захочу. ::Атака!::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a10" name="=&gt;a10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Okay, I'll remember that.&lt;end&gt;</source>
        <target state="needs-translation">Гаразд, я це запам'ятаю.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a11" name="=&gt;a11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Don't worry, I wasn't planning on going down there anyway.&lt;end&gt;</source>
        <target state="needs-translation">Не хвилюйся, я не планував спускатися туди в будь-якому випадку.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Ignore her.::&lt;end&gt;</source>
        <target state="needs-translation">::Ігноруй її.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Don't do nothin' stupid, $(#caveman/cavewoman).&lt;end&gt;</source>
        <target state="needs-translation">Не роби нічого дурного, $(#печерна людина/печерна жінка).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a14" name="=&gt;a14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>We'll see about that. ::Attack!::&lt;end&gt;</source>
        <target state="needs-translation">Подивимося. ::Атака!::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I've got my eyes on ya.&lt;end&gt;</source>
        <target state="needs-translation">Я стежу за тобою.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q17" name="=&gt;q17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Whatcha want, $(#caveman/cavewoman)?&lt;end&gt;</source>
        <target state="needs-translation">Чого ти хочеш, $(#печерна людина/печерна жінка)?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q18" name="=&gt;q18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Don't test my patience.&lt;end&gt;</source>
        <target state="needs-translation">Не випробовуй моє терпіння.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q19" name="=&gt;q19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Ya lookin' for Marty? He's in the shop. Can't miss it.&lt;end&gt;</source>
        <target state="needs-translation">Ти шукаєш Марті? Він у крамниці. Не пропустиш.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q20" name="=&gt;q20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Watch it, $(#caveman/cavewoman).&lt;end&gt;</source>
        <target state="needs-translation">Стережись, $(#печерна людина/печерна жінка).&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
