    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Sorry, no one goes through these doors. Talk to Boyd or Edgar if ya got any questions.&lt;end&gt;</source>
        <target state="needs-translation">Вибачте, ніхто не проходить через ці двері. Зверніться до Бойда або Едгара, якщо у вас є якісь питання.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
