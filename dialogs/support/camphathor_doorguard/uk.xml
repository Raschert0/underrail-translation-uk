      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Truce with the Rathound King? No comment...&lt;end&gt;</source>
        <target state="needs-translation">Перемир'я з Королем Ратхаундів? Без коментарів...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Hey, um, does this suit make me look fat?&lt;end&gt;</source>
        <target state="needs-translation">Гей, е-е, чи робить цей костюм мене товстим?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>The King is dead! Finally.&lt;end&gt;</source>
        <target state="needs-translation">Король мертвий! Нарешті.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
