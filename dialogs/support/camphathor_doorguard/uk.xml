      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Thank ya very much for slaughterin' the burrowers.&lt;end&gt;</source>
        <target state="needs-translation">Дякую вам за знищення копачів.&lt;end&gt;</target>
      </segment>
