    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>New in Core City?&lt;end&gt;</source>
        <target state="needs-translation">Новий у Ядромісті?&lt;end&gt;</target>
