        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You can't do anything stupid... you can only try.&lt;end&gt;</source>
        <target state="needs-translation">Ти не можеш зробити нічого дурного... ти можеш лише спробувати.&lt;end&gt;</target>
