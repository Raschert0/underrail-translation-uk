        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>There's been an accident here. Please don't touch anything.&lt;end&gt;</source>
        <target state="needs-translation">Тут стався нещасний випадок. Будь ласка, не чіпайте нічого.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>First time I've seen anything like this.&lt;end&gt;</source>
        <target state="needs-translation">Вперше бачу щось подібне.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>How terrible...&lt;end&gt;</source>
        <target state="needs-translation">Як жахливо...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
