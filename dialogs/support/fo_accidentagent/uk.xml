        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Damn, the smell of burnt flesh...&lt;end&gt;</source>
        <target state="needs-translation">Чорт, запах паленої плоті...&lt;end&gt;</target>
      </segment>
