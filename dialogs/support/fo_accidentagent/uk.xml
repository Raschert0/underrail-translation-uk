        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>He was a heavy drinker. Could it be...?&lt;end&gt;</source>
        <target state="needs-translation">Він любив випити. Чи може бути...?&lt;end&gt;</target>
      </segment>
    </unit>
