        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Someone better fix this thing or more people are gonna get fried.&lt;end&gt;</source>
        <target state="needs-translation">Хтось краще полагодить цю штуку, інакше більше людей підсмажиться.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
