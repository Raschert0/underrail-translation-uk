        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>My brother died recently.&lt;end&gt;</source>
        <target state="needs-translation">Мій брат нещодавно помер.&lt;end&gt;</target>
      </segment>
