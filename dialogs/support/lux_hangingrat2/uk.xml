    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I hate people. I hate Dragan. I hate you. I hate myself.&lt;end&gt;</source>
        <target state="needs-translation">Я ненавиджу людей. Я ненавиджу Драгана. Я ненавиджу тебе. Я ненавиджу себе.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I lost my right eye when I was seven years old.&lt;end&gt;</source>
        <target state="needs-translation">Я втратив праве око, коли мені було сім років.&lt;end&gt;</target>
      </segment>
    </unit>
