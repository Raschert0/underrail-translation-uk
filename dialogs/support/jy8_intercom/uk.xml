  <file id="dialogs\support\jy8_intercom.txt" original="dialogs\support\jy8_intercom.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You ring the intercom but no one answers.::&lt;end&gt;</source>
        <target state="needs-translation">::Ви дзвоните в домофон, але ніхто не відповідає.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You ring the intercom. A croaky voice answers.:: 

I haven't seen you before, stranger. Came to do some gamblin'?&lt;end&gt;</source>
        <target state="needs-translation">::Ви дзвоните в домофон. Хрипкий голос відповідає.:: 

Я раніше вас не бачив, незнайомцю. Прийшли пограти?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a4" name="=&gt;a4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yeah, can I come in?&lt;end&gt;</source>
        <target state="needs-translation">Так, чи можу я зайти?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Sure, sure, but all new members must pay twenty charons admittance fee first.&lt;end&gt;</source>
        <target state="needs-translation">Звісно, звісно, але всі нові члени повинні спочатку сплатити двадцять харонів вступного внеску.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a6" name="=&gt;a6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Alright, fair enough. ::Slip the charons through the designated crack in the door.::&lt;end&gt;</source>
        <target state="needs-translation">Гаразд, справедливо. ::Просуньте харони через призначений щілину в дверях.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Welcome aboard.&lt;end&gt;</source>
        <target state="needs-translation">Ласкаво просимо на борт.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a8" name="=&gt;a8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll have to think about this.&lt;end&gt;</source>
        <target state="needs-translation">Я подумаю над цим.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yeh. You do that.&lt;end&gt;</source>
        <target state="needs-translation">Так. Подумайте.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a10" name="=&gt;a10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Sorry, wrong house.&lt;end&gt;</source>
        <target state="needs-translation">Вибачте, не туди звернулися.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Decided to pay the fee?&lt;end&gt;</source>
        <target state="needs-translation">Ви вирішили сплатити внесок?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yeah, here's the charons. ::Slip the charons through the designated crack in the door.::&lt;end&gt;</source>
        <target state="needs-translation">Так, ось харони. ::Просуньте харони через призначений щілину в дверях.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a13" name="=&gt;a13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Maybe some other time.&lt;end&gt;</source>
        <target state="needs-translation">Можливо, іншим разом.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
