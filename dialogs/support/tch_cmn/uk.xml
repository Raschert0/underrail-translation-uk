      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Apex wear, $(#brother/sister)!&lt;end&gt;</source>
        <target state="needs-translation">Екіпірування Apex, $(#брате/сестро)!&lt;end&gt;</target>
