      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Don't know ya, $(#jack/sis).&lt;end&gt;</source>
        <target state="needs-translation">Не знаю тебе, $(#брате/сестро).&lt;end&gt;</target>
