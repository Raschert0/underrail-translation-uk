    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Found anything interesting in there?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He pulls out an empty bottle and an old rag out of the dumpster and puts them both in his coat. Afterwards, he starts walking away from the dumpster.::

&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Nothin' at all, $(#man/woman), nothin' at all. I'm off now.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a16" name="=&gt;a16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Stop! I'm not done speaking to you!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q17" name="=&gt;q17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He ignores you and continues walking away.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a18" name="=&gt;a18">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">36</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>That's it: On the ground, you're under arrest!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q19" name="=&gt;q19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::As soon as he hears, "Get down!", he ::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q20" name="=&gt;q20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::flings a bottle straight in your face and ::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q21" name="=&gt;q21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::starts running as fast as he can.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a22" name="=&gt;a22">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">44</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::[Agility] Go after him!::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a23" name="=&gt;a23">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">46</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I see you again, you're going down!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a24" name="=&gt;a24">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">48</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Say nothing.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a25" name="=&gt;a25">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">50</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>No one walks away from me! ::Attack!::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a26" name="=&gt;a26">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">52</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Let him leave.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a27" name="=&gt;a27">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">54</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>If I see you around here one more time you'll be in deep trouble, old man.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a28" name="=&gt;a28">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">56</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Say nothing.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q29" name="=&gt;q29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">58</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We gots no problems, $(#man/woman). I'm off now.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q30" name="=&gt;q30">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">60</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm gone, I'm gone! ::He turns to leave.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a31" name="=&gt;a31">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">62</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yeah, walk away again...&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a32" name="=&gt;a32">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">64</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>If I see you here the one more time I'm *really* going to get mad!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a33" name="=&gt;a33">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">66</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I have had enough of this. You are about to enter a world of pain, old man! ::Attack!::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a34" name="=&gt;a34">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">68</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why do you have to be so stubborn and keep returning to this dumpster?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q35" name="=&gt;q35">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">70</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He puts on a frown as he turns to you.:: Look at me, $(#man/woman), just look at me. Do I look like I enjoy doin' this, hmmm? I live in a damp hole in a wall, sleepin' all cramped up, freezin' myself to sleep. I dig through yo fat rat trash to find somethin' I could sell, eat or wear. It ain't fun. It ain't fun at all, $(#man/woman)! 

Having this old fart dig through your dumpster is an *inconvenience* for YOU, but it's a *necessity* for ME. It ain't right. It ain't.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q36" name="=&gt;q36">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">72</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Bah, you don't dig none of this anyway. Bah...&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a37" name="=&gt;a37">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">74</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Didn't I already tell you to keep away from my house?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a38" name="=&gt;a38">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">76</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You again!? I thought I told your sorry ass to get away from here?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a39" name="=&gt;a39">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">78</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>So we're going to repeat the whole process again, right?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a40" name="=&gt;a40">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">80</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What the hell, man!?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a41" name="=&gt;a41">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">82</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::[Intimidate]:: If I see you here one more time I'm reporting you to Praetorian enforcers. How do you feel about that?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q42" name="=&gt;q42">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">84</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Something in his expression tells you that your words hit the mark.:: Alright, $(#man/woman), I ain't gonna cause no more trouble. I'm... I'm goin' now.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q43" name="=&gt;q43">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">86</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Something in his expression tells you that your statements hasn't had any real effect on him, despite what he says.:: I'm gone, I'm gone! We gots no problems!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a44" name="=&gt;a44">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">88</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::[Intimidate]:: I'm a Praetorian Security enforcer, and if I catch you one more time you're gonna rot in the darkest, coldest, most cockroach-infested cell we got!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a45" name="=&gt;a45">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">90</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Look, if I give you some money will you go away?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q46" name="=&gt;q46">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">92</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He silently stares at you. You notice a certain glare in his eyes that wasn't there before.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a47" name="=&gt;a47">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">94</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll give you a charon if you promise never to come here again.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q48" name="=&gt;q48">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">96</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He seems somewhat disappointed, but still takes your offering, snatching it from your hand like a starving man snatches the last breadcrumb. His reply doesn't seem very convincing.::

Yeah, $(#man/woman), I'm gone for good.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a49" name="=&gt;a49">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">98</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll give you ten charons if you promise never to come here again.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q50" name="=&gt;q50">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">100</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He seems pleased by your offering and snatches it from your hand like a starving man snatches a piece of bread. His reply seem fairly honest.::

Thanks, $(#man/woman), I ain't gonna bother you no more. Bye.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a51" name="=&gt;a51">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">102</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll give you twenty charons if you promise never to come here again.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a52" name="=&gt;a52">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">104</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll give you fifty charons if you promise never to come here again.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a53" name="=&gt;a53">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">106</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll give you one hundred charons if you promise never to come here again.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a54" name="=&gt;a54">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">108</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Actually, I'm low on cash myself.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q55" name="=&gt;q55">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">110</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::He turns back to digging through the dumpster.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
