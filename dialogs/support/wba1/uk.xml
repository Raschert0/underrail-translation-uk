      </mda:metadata>
      <segment state="translated">
        <source>Sorry, $(context.player.Name). No one else is allowed inside for now.&lt;end&gt;</source>
        <target state="needs-translation">Вибачте, $(context.player.Name). Наразі нікому іншому не дозволено заходити.&lt;end&gt;</target>
