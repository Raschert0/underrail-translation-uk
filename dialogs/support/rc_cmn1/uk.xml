<?xml version='1.0' encoding='utf-8'?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\support\rc_cmn1.txt" original="dialogs\support\rc_cmn1.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You...&lt;end&gt;</source>
        <target state="needs-translation">Ти...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Greetings, welcome to Rail Crossing.&lt;end&gt;</source>
        <target state="needs-translation">Вітаю, ласкаво просимо до Rail Crossing.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>If you have the time, go and check out our bar, they've got pretty good mushroom brew there.&lt;end&gt;</source>
        <target state="needs-translation">Якщо у вас є час, зайдіть до нашого бару, там досить непоганий грибний напій.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What do the Faceless want from us?&lt;end&gt;</source>
        <target state="needs-translation">Чого хочуть Безликі від нас?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Is it just or me, or does Dude seem happier than usual?&lt;end&gt;</source>
        <target state="needs-translation">Це тільки мені здається, чи Дюд виглядає щасливішим, ніж зазвичай?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>How's it going?&lt;end&gt;</source>
        <target state="needs-translation">Як справи?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Be careful when you leave Rail Crossing. There's lots of Ironheads, Lunatics and other gangs around these parts.&lt;end&gt;</source>
        <target state="needs-translation">Будьте обережні, коли покидатимете Rail Crossing. Тут багато Залізних голів, Божевільних та інших банд.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Aliza Boudreau is a really good doctor. If you need help, go and see her.&lt;end&gt;</source>
        <target state="needs-translation">Аліза Бодро – справді хороший лікар. Якщо вам потрібна допомога, зверніться до неї.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Finally those Faceless are gone, I got pretty darn worried this was going to be the end.&lt;end&gt;</source>
        <target state="needs-translation">Нарешті ці Безликі пішли, я дуже хвилювався, що це буде кінець.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Glad to hear Buzzer's a-okay.&lt;end&gt;</source>
        <target state="needs-translation">Радий чути, що Баззер у порядку.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hi, $(context.player.Name). What's up?&lt;end&gt;</source>
        <target state="needs-translation">Привіт, $(context.player.Name). Що нового?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Poor Buzzer. I really feel sorry for the old geezer.&lt;end&gt;</source>
        <target state="needs-translation">Бідний Баззер. Мені його дуже шкода, старий дідуган.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I don't think Dude is ever sober.&lt;end&gt;</source>
        <target state="needs-translation">Я не думаю, що Дюд коли-небудь тверезий.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I heard Jared was killed while stealing some supplies from Aliza's office. Serves the ratbag right!&lt;end&gt;</source>
        <target state="needs-translation">Я чув, що Джареда вбили, коли він крадькома викрав припаси з офісу Алізи. Справді заслуговує на це, щур!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>That punk stole medical supplies!? *Our* medical supplies?&lt;end&gt;</source>
        <target state="needs-translation">Цей покидьок вкрав медичні припаси!? *Наші* медичні припаси?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q17" name="=&gt;q17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Finally! The supplies have arrived!&lt;end&gt;</source>
        <target state="needs-translation">Нарешті! Прибули припаси!&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
