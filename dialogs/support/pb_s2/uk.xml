<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\support\pb_s2.txt" original="dialogs\support\pb_s2.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Welcome to Fort Apogee, citizen.&lt;end&gt;</source>
        <target state="needs-translation">Ласкаво просимо до Форту Апогей, громадянине.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Salutes::&lt;end&gt;</source>
        <target state="needs-translation">::Салютує::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>It is our duty to protect all those who cannot protect themselves.&lt;end&gt;</source>
        <target state="needs-translation">Це наш обов'язок захищати всіх, хто не може захистити себе.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I serve Underrail Protectorate proudly, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Я з гордістю служу Протекторату Підземного Світу, $(#сер/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>If you need medical assistance, Doctor Anastasia Merrick can be found in the eastern part of Fort Apogee.&lt;end&gt;</source>
        <target state="needs-translation">Якщо вам потрібна медична допомога, доктор Анастасія Меррік знаходиться у східній частині Форту Апогей.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I was told Foundry Guard had a prison riot recently. Hm.&lt;end&gt;</source>
        <target state="needs-translation">Мені сказали, що в Foundry Guard нещодавно було тюремне повстання. Хм.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Do you think the Faceless might attack Fort Apogee, $(#sir/ma'am)?&lt;end&gt;</source>
        <target state="needs-translation">Як ви думаєте, Безликі можуть напасти на Форт Апогей, $(#сер/пані)?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>If every one of us had his own Dreadnought, combat would be so much easier, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Якби у кожного з нас був свій Дредноут, боротьба була б набагато легшою, $(#сер/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Any info on what happened in the Tchortist institute?&lt;end&gt;</source>
        <target state="needs-translation">Будь-яка інформація про те, що сталося в Інституті Тчортиста?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I don't understand the Free Drones: Why won't they accept we're here to help, not to conquer?&lt;end&gt;</source>
        <target state="needs-translation">Я не розумію Вільних Дронів: чому вони не погоджуються, що ми тут, щоб допомогти, а не завоювати?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Despite our decisive victory, I fear more Free Drones will come from the North, $(#sir/ ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Незважаючи на нашу рішучу перемогу, я боюся, що з Півночі прийде більше Вільних Дронів, $(#сер/пані).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I had good friends in Epione Lab...&lt;end&gt;</source>
        <target state="needs-translation">У мене були хороші друзі в Epione Lab...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I really don't like the Chems, $(#sir/ma'am). I've heard horrible things about them.&lt;end&gt;</source>
        <target state="needs-translation">Мені дійсно не подобаються Хімики, $(#сер/пані). Я чув жахливі речі про них.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Luka sells some quality stuff, if you've got the blues.&lt;end&gt;</source>
        <target state="needs-translation">Лука продає якісну штуку, якщо вам сумно.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I'm glad SFC Holloway finally came to his senses.&lt;end&gt;</source>
        <target state="needs-translation">Я радий, що SFC Холлоуей нарешті розсудився.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q17" name="=&gt;q17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Good to hear the situation in Core City has stabilized.&lt;end&gt;</source>
        <target state="needs-translation">Радий чути, що ситуація в Core City стабілізувалася.&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
