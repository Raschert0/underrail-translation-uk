        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>There's a lot of work to be done here.&lt;end&gt;</source>
        <target state="needs-translation">Тут багато роботи.&lt;end&gt;</target>
      </segment>
