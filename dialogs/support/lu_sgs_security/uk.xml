      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Harland seems pretty pleased with his new minibot.&lt;end&gt;</source>
        <target state="needs-translation">Гарланд здається дуже задоволений своїм новим мініботом.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Are there really mutants in Old Junkyard?&lt;end&gt;</source>
        <target state="needs-translation">Чи дійсно в Старому Звалищі є мутанти?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
