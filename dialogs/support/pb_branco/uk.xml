      </mda:metadata>
      <segment state="translated">
        <source>You're not supposed to be here. Out!&lt;end&gt;</source>
        <target state="needs-translation">Тобі не місце тут. Геть!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
