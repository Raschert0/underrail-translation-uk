    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Can't a man have some peace?&lt;end&gt;</source>
        <target state="needs-translation">Хіба людина не може мати спокою?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>$(#Brother/Sister), I don't remember inviting you in...&lt;end&gt;</source>
        <target state="needs-translation">$(#Брат/Сестра), я не пригадую, щоб запрошував тебе...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Blistering tentacles! What are you doing here?&lt;end&gt;</source>
        <target state="needs-translation">Палаючі щупальця! Що ти тут робиш?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I don't care what you want; I care about you leaving me alone!&lt;end&gt;</source>
        <target state="needs-translation">Мені байдуже, чого ти хочеш; мені важливо, щоб ти залишив мене наодинці!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Is there a sign on my door saying, "Please barge in whenever you like"?&lt;end&gt;</source>
        <target state="needs-translation">Чи є на моїх дверях напис: "Будь ласка, вривайся, коли заманеться"?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Do you have a vestigial brain, $(#brother/sister)? Out of my room!&lt;end&gt;</source>
        <target state="needs-translation">У тебе є рудиментарний мозок, $(#брат/сестра)? Геть з моєї кімнати!&lt;end&gt;</target>
      </segment>
    </unit>
