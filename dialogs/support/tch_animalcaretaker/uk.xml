      </mda:metadata>
      <segment state="translated">
        <source>I will stand my ground!&lt;end&gt;</source>
        <target state="needs-translation">Я буду стояти на своєму!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Psycho is the most dangerous one of them all!&lt;end&gt;</source>
        <target state="needs-translation">Психо - найнебезпечніший з них усіх!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
