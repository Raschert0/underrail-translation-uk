    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Okay, next train, Sammy... the next train is yours! You can do this...&lt;end&gt;</source>
        <target state="needs-translation">Гаразд, наступний потяг, Семмі... наступний потяг – твій! Ти можеш це зробити...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm gonna miss the Arena...&lt;end&gt;</source>
        <target state="needs-translation">Я сумуватиму за Ареною...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I wish I was never born...&lt;end&gt;</source>
        <target state="needs-translation">Я хотів би ніколи не народитися...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
