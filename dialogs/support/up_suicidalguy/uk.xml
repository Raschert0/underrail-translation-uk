    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Damn it, Sammy! Do it, you stupid zoner!&lt;end&gt;</source>
        <target state="needs-translation">Чорт забирай, Семмі! Зроби це, ти, нещасний зонер!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>JUMP! No... no... not yet! Damn it...&lt;end&gt;</source>
        <target state="needs-translation">СТРИБНИ! Ні... ні... ще не зараз! Чорт забирай...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Okay... Okay... Okay... Aaaand... Wait... Okay....&lt;end&gt;</source>
        <target state="needs-translation">Гаразд... Гаразд... Гаразд... Ааа... Зачекай... Гаразд....&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Sammy! Sammy! Be a man for once in your miserable life and end it now!&lt;end&gt;</source>
        <target state="needs-translation">Семмі! Семмі! Будь чоловіком хоч раз у своєму жалюгідному житті і закінчи це зараз!&lt;end&gt;</target>
      </segment>
    </unit>
