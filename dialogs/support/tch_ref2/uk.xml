  <file id="dialogs\support\tch_ref2.txt" original="dialogs\support\tch_ref2.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We must resist the Faceless!&lt;end&gt;</source>
        <target state="needs-translation">Ми повинні чинити опір Безликим!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tchort is evolution.&lt;end&gt;</source>
        <target state="needs-translation">Тчорт - це еволюція.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Refectory is a place to sit down and relax... and enjoy your meal.&lt;end&gt;</source>
        <target state="needs-translation">Рефракторій - це місце, щоб посидіти та розслабитися... і насолодитися їжею.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>There is something special about the clanking of cutlery in this place. I've really grown fond of it.&lt;end&gt;</source>
        <target state="needs-translation">У цьому місці є щось особливе в брязкоті столових приборів. Я дійсно полюбив це.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Doing fine, $(context.player.Name)?&lt;end&gt;</source>
        <target state="needs-translation">Як справи, $(context.player.Name)?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Did you know that Monsignor Gustav was sitting at that same table over there when he choked to death. Tragic...&lt;end&gt;</source>
        <target state="needs-translation">Чи знали ви, що монсеньйор Густав сидів за тим самим столом, коли вдавився. Трагічно...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tchort guide the chef!&lt;end&gt;</source>
        <target state="needs-translation">Тчорт направляє шеф-кухаря!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Ugh... I might have ate a bit too much...&lt;end&gt;</source>
        <target state="needs-translation">Ух... Я, мабуть, трохи переїв...&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
