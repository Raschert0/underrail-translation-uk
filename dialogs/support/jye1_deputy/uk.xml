    <unit id="=&gt;a48" name="=&gt;a48">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">96</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I thought becoming the Invictus will come with a lot of benefits. Wrong again.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q49" name="=&gt;q49">
      <mda:metadata>
