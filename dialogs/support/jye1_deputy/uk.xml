    <unit id="=&gt;q32" name="=&gt;q32">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">64</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Only the very best. Ambassador Athanas is one hard-working, intelligent man who is sincerely devoted to promoting and realizing the idea of unification here in South Underrail. It is a slow and time-consuming process, but the United Stations are gaining more and more support, thankfully.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q33" name="=&gt;q33">
