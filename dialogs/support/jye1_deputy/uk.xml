        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">108</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>A black marble. Had it with me since I was a kid. It means a lot to me.&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a55" name="=&gt;a55">
