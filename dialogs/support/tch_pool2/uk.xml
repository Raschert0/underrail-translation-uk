      </mda:metadata>
      <segment state="translated">
        <source>So, $(#brother/sister), anything new with you?&lt;end&gt;</source>
        <target state="needs-translation">Тож, $(#brother/sister), що нового у тебе?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Magnificent Tchort! Will you hit the damn ball already?&lt;end&gt;</source>
        <target state="needs-translation">Величний Тчорт! Ти вже заб’єш цю прокляту кулю?&lt;end&gt;</target>
      </segment>
    </unit>
