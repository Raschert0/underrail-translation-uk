  <file id="dialogs\support\cc_psg1.txt" original="dialogs\support\cc_psg1.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Let's watch some Arena!&lt;end&gt;</source>
        <target state="needs-translation">Давайте подивимося Арену!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I have this nasty rash on my arm. Look! ::Shows you the rash.::&lt;end&gt;</source>
        <target state="needs-translation">У мене на руці цей жахливий висип. Поглянь! ::Показує тобі висип.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I wish all these motioners would just zone out of here and let me watch the damn match!&lt;end&gt;</source>
        <target state="needs-translation">Я хотів би, щоб всі ці балакуни просто зникли звідси і дали мені подивитися матч!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Stomach full, mind rested, body mostly clean. Time to watch the Arena.&lt;end&gt;</source>
        <target state="needs-translation">Живіт повний, розум відпочиває, тіло здебільшого чисте. Час дивитися Арену.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>No more motioners to bug me! Yay!&lt;end&gt;</source>
        <target state="needs-translation">Більше балакунів, які не заважають мені! Ура!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Carnifex, you were the best. Rest in peace.&lt;end&gt;</source>
        <target state="needs-translation">Карніфекс, ти був найкращим. Спочивай з миром.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I should do something else with my life. I know, let's watch some Gauntlet!&lt;end&gt;</source>
        <target state="needs-translation">Я повинен якось змінити своє життя. Знаю, давайте подивимося Гаунтлет!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Whistles an unfamiliar tune.::&lt;end&gt;</source>
        <target state="needs-translation">::Свистить незнайому мелодію.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>At least I'm not living in the sewers.&lt;end&gt;</source>
        <target state="needs-translation">Принаймні, я не живу в каналізації.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Tunnelers are gone. Back to watching the Arena, I suppose.&lt;end&gt;</source>
        <target state="needs-translation">Тунелери зникли. Повертаємося до перегляду Арени, гадаю.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Is it true that the Hathorians were also attacked by the Faceless?&lt;end&gt;</source>
        <target state="needs-translation">Чи правда, що на хаторіанців також напали Безликі?&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
