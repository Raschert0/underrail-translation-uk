  <file id="dialogs\support\jy_invadingsgssoldier.txt" original="dialogs\support\jy_invadingsgssoldier.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>That was... underwhelming.&lt;end&gt;</source>
        <target state="needs-translation">Це було... не вражаюче.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">Там їх більше. Тримайтеся ближче.</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>There's more of them. Stay close.&lt;end&gt;</source>
        <target state="needs-translation">Ми прикриємо тебе, $(context.player.Name).</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We got your back, $(context.player.Name).&lt;end&gt;</source>
        <target state="needs-translation">Це була кривава битва.</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>That was a bloody battle.&lt;end&gt;</source>
        <target state="needs-translation">Вугри зазнали серйозних втрат.</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source> The Eels took some serious casualties.&lt;end&gt;</source>
        <target state="needs-translation">Вугри зазнали серйозних втрат.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">Нам потрібно відбудувати барикаду до Депо А.</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We need to rebuild the barricade towards Depot A.&lt;end&gt;</source>
        <target state="needs-translation">::Від тут до безплідної підлоги внизу, під обривом, здається досить далеко. Ти відчуваєш, що зможеш спуститися достатньо низько, щоб припуститися відносно безпечно, відпустивши хватку; однак, ти не зможеш вилізти назад, оскільки, спустившись, ти більше не зможеш дістатись до отвору, з якого спустився.::</target>
      </segment>
    </unit>
  </file>
