<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\support\dc_tchortistentrance.txt" original="dialogs\support\dc_tchortistentrance.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Get lost, traitor.&lt;end&gt;</source>
        <target state="needs-translation">Зникни, зрадник.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>His Excellency is waiting for you in his office. Go straight, then left.&lt;end&gt;</source>
        <target state="needs-translation">Його Високоповажність чекає на вас у своєму кабінеті. Йдіть прямо, потім ліворуч.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>If you need supplies, speak to Prevlic in the armory.&lt;end&gt;</source>
        <target state="needs-translation">Якщо вам потрібні припаси, зверніться до Превліча в арсеналі.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I'm sure now that there are more of us alive. We can defeat the Faceless!&lt;end&gt;</source>
        <target state="needs-translation">Я впевнений, що нас ще більше живих. Ми можемо перемогти Безликих!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I knew Eidein wouldn't fall to the Faceless!&lt;end&gt;</source>
        <target state="needs-translation">Я знав, що Ейдейн не впаде до рук Безликих!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Are we all that's left?&lt;end&gt;</source>
        <target state="needs-translation">Чи залишилися ми всі?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>The Faceless will pay for all the lives they took!&lt;end&gt;</source>
        <target state="needs-translation">Безликі заплатять за всі життя, які вони забрали!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>We will protect Tchort until our last breath, $(#brother/sister).&lt;end&gt;</source>
        <target state="needs-translation">Ми будемо захищати Тчорт до останнього подиху, $(#brother/sister).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>$(#Brother/Sister)?&lt;end&gt;</source>
        <target state="needs-translation">$(#Brother/Sister)?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>We've heard the good news! We just need to hold on a bit longer.&lt;end&gt;</source>
        <target state="needs-translation">Ми почули добрі новини! Нам просто потрібно трохи почекати.&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
