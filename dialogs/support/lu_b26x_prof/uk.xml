      <segment state="translated">
        <source>They call me Prof 'cause I teach people valuable lessons.&lt;end&gt;</source>
        <target state="needs-translation">Мене називають Професором, тому що я навчаю людей цінним урокам.&lt;end&gt;</target>
      </segment>
    </unit>
