  <file id="dialogs\support\cc_ps_recruittired.txt" original="dialogs\support\cc_ps_recruittired.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Breathes heavily.:: Make him stop, damn it!&lt;end&gt;</source>
        <target state="needs-translation">::Важко дихає.:: Змусь його зупинитися, клянуся!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Me ticker's gonna pop!&lt;end&gt;</source>
        <target state="needs-translation">Мій пульс зараз вискочить!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>And to think I wanted to become a gladiator. Bloody hell!&lt;end&gt;</source>
        <target state="needs-translation">І я думав, я стану гладіатором. Чорт забирай!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Breathes heavily.::&lt;end&gt;</source>
        <target state="needs-translation">::Важко дихає.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>He's killing us here...&lt;end&gt;</source>
        <target state="needs-translation">Він тут нас вбиває...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Bloody bastard, I'll show ya how's it done. After I rest for a while...&lt;end&gt;</source>
        <target state="needs-translation">Клятий негідник, я тобі покажу, як це робиться. Після того, як трохи відпочну...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Me muscles are in pain, some of them I never knew I had in me.&lt;end&gt;</source>
        <target state="needs-translation">Мої м'язи болять, деякі з них я навіть не знав, що в мене є.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>That's it - I'm passing out!&lt;end&gt;</source>
        <target state="needs-translation">Все, я втрачаю свідомість!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Maybe this was a mistake. ::Pants.::&lt;end&gt;</source>
        <target state="needs-translation">Можливо, це була помилка. ::Задихається.::&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
