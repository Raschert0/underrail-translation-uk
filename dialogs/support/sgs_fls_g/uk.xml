<?xml version='1.0' encoding='utf-8'?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\support\sgs_fls_g.txt" original="dialogs\support\sgs_fls_g.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I heard you guys found burrowers in GMS.&lt;end&gt;</source>
        <target state="needs-translation">Я чув, ви знайшли копачів у GMS.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>$(context.player.Name).&lt;end&gt;</source>
        <target state="needs-translation">$(context.player.Name).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Rest in peace, Gorsky. I'm sure you went out with a bang.&lt;end&gt;</source>
        <target state="needs-translation">Спочивай з миром, Горський. Впевнений, ти пішов з гуркотом.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We're on the lookout for the Faceless.&lt;end&gt;</source>
        <target state="needs-translation">Ми шукаємо Безликих.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Avoid the under-passages.&lt;end&gt;</source>
        <target state="needs-translation">Уникайте підземних переходів.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Some tunnels are poorly lit, so you better bring night vision goggles.&lt;end&gt;</source>
        <target state="needs-translation">Деякі тунелі погано освітлені, тому краще візьміть з собою окуляри нічного бачення.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Damn, the smell of rathound droppings around here... Phew!&lt;end&gt;</source>
        <target state="needs-translation">Чорт, тут сморід посліду щурів... Фу!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why is this old geezer here, again?&lt;end&gt;</source>
        <target state="needs-translation">Чому цей старий тут знову?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hey there. Where have you been all this time?&lt;end&gt;</source>
        <target state="needs-translation">Привіт. Де ви були весь цей час?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hi. Nice of you to pay us a visit down here.&lt;end&gt;</source>
        <target state="needs-translation">Привіт. Приємно, що ви завітали до нас сюди.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Good work on securing these outposts, $(context.player.Name).&lt;end&gt;</source>
        <target state="needs-translation">Хороша робота з забезпечення безпеки цих аванпостів, $(context.player.Name).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Not a rathound in sight. These bright lights must've scared off the ones you didn't kill.&lt;end&gt;</source>
        <target state="needs-translation">Жодного щурів поблизу. Ці яскраві вогні, мабуть, налякали тих, яких ви не вбили.&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
