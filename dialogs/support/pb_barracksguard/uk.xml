      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Wh-- What's the matter with you? I told you this is a restricted area!&lt;end&gt;</source>
        <target state="needs-translation">Що-- Що з тобою? Я ж казав, це закрита територія!&lt;end&gt;</target>
