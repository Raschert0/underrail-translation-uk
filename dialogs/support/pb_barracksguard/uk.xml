    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Stop. You don't have permission to enter this area. ::He motions you to turn around.:: The consulate is in the opposite way.&lt;end&gt;</source>
        <target state="needs-translation">Стоп. У вас немає дозволу входити в цю зону. ::Він жестом просить вас повернутися.:: Консульство в протилежному напрямку.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a2" name="=&gt;a2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Okay, thanks for the reminder.&lt;end&gt;</source>
        <target state="needs-translation">Добре, дякую за нагадування.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a3" name="=&gt;a3">
      <mda:metadata>
