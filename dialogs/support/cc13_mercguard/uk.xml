  <file id="dialogs\support\cc13_mercguard.txt" original="dialogs\support\cc13_mercguard.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Get outta here already!&lt;end&gt;</source>
        <target state="needs-translation">Геть звідси!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The man raises his hand and signals you to stop.::

Hey, you! This is private property. I *suggest* you turn around.&lt;end&gt;</source>
        <target state="needs-translation">::Чоловік піднімає руку і дає вам знак зупинитися.::

Гей, ти! Це приватна власність. Я *пропоную* тобі повернутися.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a3" name="=&gt;a3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What's in there?&lt;end&gt;</source>
        <target state="needs-translation">Що там?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Pain if you don't get lost. Filthy dropper!&lt;end&gt;</source>
        <target state="needs-translation">Біль, якщо ти не зникнеш. Брудний крапельник!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a5" name="=&gt;a5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Pain it is. ::Attack!::&lt;end&gt;</source>
        <target state="needs-translation">Біль буде. ::Атакуй!::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a6" name="=&gt;a6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Fine. Goodbye.&lt;end&gt;</source>
        <target state="needs-translation">Гаразд. До побачення.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a7" name="=&gt;a7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Who are you?&lt;end&gt;</source>
        <target state="needs-translation">Хто ти?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll tell you who I'm not - a patient man. Get outta here, you darn dropper!&lt;end&gt;</source>
        <target state="needs-translation">Я скажу вам, хто я не є - терпляча людина. Геть звідси, ти проклятий крапельник!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a9" name="=&gt;a9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I don't think so. ::Attack!::&lt;end&gt;</source>
        <target state="needs-translation">Я так не думаю. ::Атакуй!::&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
