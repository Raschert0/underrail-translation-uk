    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Stay vicious, $(context.player.Name).&lt;end&gt;</source>
        <target state="needs-translation">Будь жорстоким, $(context.player.Name).&lt;end&gt;</target>
      </segment>
