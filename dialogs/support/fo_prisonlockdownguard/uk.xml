      </mda:metadata>
      <segment state="translated">
        <source>That is classified information.&lt;end&gt;</source>
        <target state="needs-translation">Це конфіденційна інформація.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
