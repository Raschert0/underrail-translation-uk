  <file id="dialogs\support\pb_nancy.txt" original="dialogs\support\pb_nancy.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Goodbye, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">До побачення, $(#sir/ma'am).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>If you're looking for Colonel Cathcart, he is in Consul Oliver's office.&lt;end&gt;</source>
        <target state="needs-translation">Якщо ви шукаєте полковника Кеткарта, він в кабінеті консула Олівера.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Consul Oliver's doors are always open to you, $(context.player.Name).&lt;end&gt;</source>
        <target state="needs-translation">Двері консула Олівера завжди відкриті для вас, $(context.player.Name).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Sighs.::&lt;end&gt;</source>
        <target state="needs-translation">::Зітхає.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>How can I help you, handso-- I mean, $(context.player.Name).&lt;end&gt;</source>
        <target state="needs-translation">Чим я можу вам допомогти, гарний... тобто, $(context.player.Name).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>It is an honor to be working for the United Stations consulate.&lt;end&gt;</source>
        <target state="needs-translation">Це честь – працювати на консульство Об'єднаних Станцій.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>The Faceless invasion forced many North Underrail citizens to seek protection right here, in Fort Apogee.&lt;end&gt;</source>
        <target state="needs-translation">Вторгнення Безликих змусило багатьох громадян Північного Андеррейлу шукати захисту тут, у Форті Апогей.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::She checks her nails.:: Oh no! I broke one!&lt;end&gt;</source>
        <target state="needs-translation">::Вона перевіряє нігті.:: О ні! Я зламала один!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Hums an unfamiliar tune.::&lt;end&gt;</source>
        <target state="needs-translation">::Наспівує незнайому мелодію.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>I need some rest. This job is hard.&lt;end&gt;</source>
        <target state="needs-translation">Мені потрібен відпочинок. Ця робота важка.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Take the door behind me. The consul is expecting you.&lt;end&gt;</source>
        <target state="needs-translation">Ідіть дверима за мною. Консул чекає на вас.&lt;end&gt;</target>
      </segment>
    </unit>
