    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I need to sharpen my knife. ::Coughs.::&lt;end&gt;</source>
        <target state="needs-translation">Мені потрібно заточити ніж. ::Кашляє.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I haven't eaten in days. ::Stomach growls.::&lt;end&gt;</source>
        <target state="needs-translation">Я не їв вже кілька днів. ::Живіт бурчить.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Please come closer. Let me see you better. ::Coughs.::&lt;end&gt;</source>
        <target state="needs-translation">Будь ласка, підійди ближче. Дай мені краще тебе роздивитися. ::Кашляє.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You look well fed. Good...&lt;end&gt;</source>
        <target state="needs-translation">Ти виглядаєш ситим. Добре...&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Extends arm and tries to touch you but changes mind in the last second.::&lt;end&gt;</source>
        <target state="needs-translation">::Простягає руку і намагається торкнутися тебе, але в останню секунду передумає.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>BOO! ::Laughs out loud.:: Gotcha!&lt;end&gt;</source>
        <target state="needs-translation">БУ! ::Вибухає сміхом.:: Злякав тебе!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm so hungry!&lt;end&gt;</source>
        <target state="needs-translation">Я так голодний!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I feel so friable. ::Coughs.::&lt;end&gt;</source>
        <target state="needs-translation">Я відчуваю себе таким крихким. ::Кашляє.::&lt;end&gt;</target>
      </segment>
    </unit>
