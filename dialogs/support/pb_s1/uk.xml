<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\support\pb_s1.txt" original="dialogs\support\pb_s1.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Move along, citizen.&lt;end&gt;</source>
        <target state="needs-translation">Проходьте, громадянине.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Salutes:: Corporal.&lt;end&gt;</source>
        <target state="needs-translation">Ми найкращі, $(#sir/ma'am)!</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>We are the best, $(#sir/ma'am)!&lt;end&gt;</source>
        <target state="needs-translation">Ура!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Hoorah!&lt;end&gt;</source>
        <target state="needs-translation">Форт Апогей – неприступна фортеця. Ніхто не наважується нас чіпати, $(#sir/ma'am)!</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Fort Apogee is an impenetrable fortress. No one dares touch us, $(#sir/ma'am)!&lt;end&gt;</source>
        <target state="needs-translation">Ти мені дуже нагадуєш нового Інвіктуса, $(#sir/ma'am). Якби ти був трохи вищий – одна й та сама людина.</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>You really remind me of the new Invictus, $(#sir/ma'am). If you were a bit taller - same person.&lt;end&gt;</source>
        <target state="needs-translation">Якщо ці смердючі Безликі навіть подумають про атаку, ми покажемо їм, на що ми здатні, $(#sir/ma'am).</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>If those stinking Faceless even think about engaging, we'll show them what we're made of, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Якщо тобі потрібно обміняти трохи грошей, звернись до головного сержанта Фрейзера.</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>If you need to exchange some blues, see Staff Sergeant Fraser.&lt;end&gt;</source>
        <target state="needs-translation">Безликі втекли, $(#sir/ma'am).</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>The Faceless ran away, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Вільні Дрони – бережись, може бути Протекторат!</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Free Drones - beware the Protectorate might!&lt;end&gt;</source>
        <target state="needs-translation">Правда, що осередок Вільних Дронів був повністю знищений, $(#sir/ma'am)?</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Is it true that the Free Drones cell has been completely decimated, $(#sir/ma'am)?&lt;end&gt;</source>
        <target state="needs-translation">Як ми могли дозволити цим анархістським бандитам знищити Епіоне?</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>How could we've allowed those anarchist bandits to take out Epione?&lt;end&gt;</source>
        <target state="needs-translation">Хімія тут, $(#sir/ma'am).</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Chems are here, $(#sir/ma'am).&lt;end&gt;</source>
        <target state="needs-translation">Поглянь на ці Дредноути, $(#sir/ma'am) – символ могутності Протекторату.</target>
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Check out those Dreadnoughts, $(#sir/ma'am) - the symbol of Protectorate might.&lt;end&gt;</source>
        <target state="needs-translation">Чув про SFC Голлоуея та його людей, $(#sir/ma'am)?</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Heard about SFC Holloway and his men, $(#sir/ma'am)?&lt;end&gt;</source>
        <target state="needs-translation">Чого ти хочеш?</target>
      </segment>
    </unit>
  </file>
