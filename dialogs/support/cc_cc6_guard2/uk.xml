      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I wonder if there are any Black Crawlers still active.&lt;end&gt;</source>
        <target state="needs-translation">Цікаво, чи ще є активні Чорні Повзуни.&lt;end&gt;</target>
