      </mda:metadata>
      <segment state="translated">
        <source>Oh look, a prisoner moved. Exciting...&lt;end&gt;</source>
        <target state="needs-translation">О, подивіться, в'язня перевели. Захопливо...&lt;end&gt;</target>
