    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I like writing poetry. It helps me... express myself.&lt;end&gt;</source>
        <target state="needs-translation">Я люблю писати вірші. Це допомагає мені... виражати себе.&lt;end&gt;</target>
      </segment>
    </unit>
