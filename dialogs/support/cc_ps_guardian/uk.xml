        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Good day to be a Praetorian. Isn't it, Enforcer?&lt;end&gt;</source>
        <target state="new" />
