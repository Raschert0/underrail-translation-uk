        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hold it! You are approaching a restricted area. Only employees and recruits are allowed past this point.&lt;end&gt;</source>
        <target state="new" />
