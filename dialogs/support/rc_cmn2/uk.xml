<?xml version='1.0' encoding='utf-8'?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\support\rc_cmn2.txt" original="dialogs\support\rc_cmn2.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What you've done ain't right, you know.&lt;end&gt;</source>
        <target state="needs-translation">Те, що ти зробив, неправильно, знаєш.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hi there, stranger, where are you from?&lt;end&gt;</source>
        <target state="needs-translation">Привіт, незнайомцю, звідки ти?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Damn it, if only we hadn't lost Buzzer.&lt;end&gt;</source>
        <target state="needs-translation">Чорт забирай, якби ми не втратили Баззера.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>If all the gangs around Rail Crossing weren't enough, now the Faceless are giving us trouble.&lt;end&gt;</source>
        <target state="needs-translation">Якщо й так багато банд навколо Перехрестя, тепер Безликі завдають нам клопоту.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Dude is a pretty odd guy, if you ask me.&lt;end&gt;</source>
        <target state="needs-translation">Хлопець досить дивний, якщо ти мене запитаєш.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Whistles a somewhat familiar tune.::&lt;end&gt;</source>
        <target state="needs-translation">::Свистить дещо знайому мелодію.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Faceless be damned for killing Buzzer.&lt;end&gt;</source>
        <target state="needs-translation">До біса Безликі за вбивство Баззера.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Believe me, there are worse places to live in than Rail Crossing.&lt;end&gt;</source>
        <target state="needs-translation">Повір мені, є гірші місця для життя, ніж Перехрестя.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I need new shoes.&lt;end&gt;</source>
        <target state="needs-translation">Мені потрібне нове взуття.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Ah, $(context.player.Name), great to see you again.&lt;end&gt;</source>
        <target state="needs-translation">Ах, $(context.player.Name), чудово знову тебе бачити.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Get outta here, monsters! And don't come back!&lt;end&gt;</source>
        <target state="needs-translation">Геть звідси, монстри! І не повертайтеся!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Buzzer made it, thanks to you.&lt;end&gt;</source>
        <target state="needs-translation">Баззер вижив завдяки тобі.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Praise the Protectorate!&lt;end&gt;</source>
        <target state="needs-translation">Хвала Протекторату!&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
