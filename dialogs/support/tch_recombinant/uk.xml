        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Efreitor Mateo will be remembered for his dedication to Tchortism.&lt;end&gt;</source>
        <target state="needs-translation">Ефрейтор Матео буде запам'ятаний за свою відданість Тчортизму.&lt;end&gt;</target>
