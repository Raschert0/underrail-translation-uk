    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>If the Faceless come bothering us here... we will squash them like bugs.&lt;end&gt;</source>
        <target state="needs-translation">Якщо Безликі почнуть турбувати нас тут... ми розчавимо їх, як жуків.&lt;end&gt;</target>
      </segment>
    </unit>
