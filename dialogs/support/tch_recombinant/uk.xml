        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Tchort is evolution.&lt;end&gt;</source>
        <target state="needs-translation">Тчорт - це еволюція.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Stares at you.:: What is this armor you're wearing?&lt;end&gt;</source>
        <target state="needs-translation">::Дивиться на вас.:: Що це за броню ви носите?&lt;end&gt;</target>
      </segment>
