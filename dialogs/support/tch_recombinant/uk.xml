        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Do you too wish to be big and strong?&lt;end&gt;</source>
        <target state="needs-translation">Ви теж хочете бути великим і сильним?&lt;end&gt;</target>
      </segment>
