<?xml version='1.0' encoding='utf-8'?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" xmlns:mda="urn:oasis:names:tc:xliff:metadata:2.0" version="2.0" srcLang="en" trgLang="uk">
  <file id="dialogs\support\pb_work.txt" original="dialogs\support\pb_work.txt">
    <unit id="=&gt;q1" name="=&gt;q1">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hey $(#buddy/doll), I'm busy. Go bug someone else.&lt;end&gt;</source>
        <target state="needs-translation">Гей $(#друже/лялечко), я зайнятий. Іди потурбуй когось іншого.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>&lt;end&gt;</source>
        <target state="translated">&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>There's a lot of work to do in Fort Apogee, trust me.&lt;end&gt;</source>
        <target state="needs-translation">У Форті Апогей багато роботи, повірте мені.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Hello, $(#sir/ma'am), may I help you?&lt;end&gt;</source>
        <target state="needs-translation">Привіт, $(#сер/пані), чи можу я вам допомогти?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Wow, that Drones attack was really unexpected!&lt;end&gt;</source>
        <target state="needs-translation">Вау, атака Дронів була справді несподіваною!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Once, a guy tried to enter the mess hall with a Dreadnought. It ended badly!&lt;end&gt;</source>
        <target state="needs-translation">Одного разу хлопець спробував увійти до їдальні з Дредноутом. Все закінчилося погано!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Fort Apogee is the safest place I've ever worked in.&lt;end&gt;</source>
        <target state="needs-translation">Форт Апогей - найбезпечніше місце, де я коли-небудь працював.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You need blues to buy stuff here. That's dollars, in case you don't know.&lt;end&gt;</source>
        <target state="needs-translation">Вам потрібні блюзи, щоб купувати речі тут. Це долари, якщо ви не знаєте.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Who were those scary-looking people?&lt;end&gt;</source>
        <target state="needs-translation">Хто були ці страшні люди?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Heard the Drones got toasted. Doesn't help me with my work, though.&lt;end&gt;</source>
        <target state="needs-translation">Чув, що Дронів підсмажили. Але це не допоможе мені з моєю роботою.&lt;end&gt;</target>
      </segment>
    </unit>
  </file>
