    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Not now, $(#brother/sister), can't you see I'm busy.&lt;end&gt;</source>
        <target state="needs-translation">Не зараз, $(#брате/сестро), хіба ти не бачиш, що я зайнята.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Come on, novitiate, let me talk to the minister.&lt;end&gt;</source>
        <target state="needs-translation">Нумо, новіате, дозволь мені поговорити з міністром.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Stop bothering me.&lt;end&gt;</source>
        <target state="needs-translation">Перестань мене турбувати.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We are trying to talk to Minister Percival, $(#brother/sister).&lt;end&gt;</source>
        <target state="needs-translation">Ми намагаємося поговорити з міністром Персівалом, $(#брате/сестро).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Yes, yes... we know all about the Reaching Man. Apex. Now leave us.&lt;end&gt;</source>
        <target state="needs-translation">Так, так… ми все знаємо про Чоловіка, що досягає. Apex. Тепер залиште нас.&lt;end&gt;</target>
      </segment>
    </unit>
