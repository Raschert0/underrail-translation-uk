      </mda:metadata>
      <segment state="translated">
        <source>Novitiate.&lt;end&gt;</source>
        <target state="needs-translation">Новіат.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Have you seen Minister Percival recently, $(#brother/sister)?&lt;end&gt;</source>
        <target state="needs-translation">Ви бачили міністра Персіваля останнім часом, $(#брате/сестро)?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
