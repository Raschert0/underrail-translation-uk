        <mda:meta type="pos_id">150</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Disobeying my orders will have consequences. I will report this incident to my superiors.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
