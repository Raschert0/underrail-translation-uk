      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">156</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The enforcer pauses for a moment and turns around towards you.:: You are from the Institute? I'm sorry but we've been instructed not to have any contacts with members of your organization while out here on this mission. ::He waves you away and returns back to tinkering on his device.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
