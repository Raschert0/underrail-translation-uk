        <source>Coretech agent here, need some help?&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q53" name="=&gt;q53">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">106</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The enforcer is fixated on his current problem of trying to fix the device in his hands. He's lifting it up and down while inspecting every little detail about it. However, whatever he tries to do, it has no effect.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a54" name="=&gt;a54">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">108</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>HELLO!? I'm from Coretech! I can fix the device for you!&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a55" name="=&gt;a55">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">110</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Turn around and leave.::&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a56" name="=&gt;a56">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">112</mda:meta>
      </mda:metadata>
      <segment state="translated">
