    <unit id="=&gt;q19" name="=&gt;q19">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">38</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The enforcer spins the device and looks at it from all sides, seemingly questioning everything about it.::

And why would we accept your help?&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a20" name="=&gt;a20">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">40</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I am a skilled electrician and here I see a good work opportunity.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;q21" name="=&gt;q21">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">42</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Is that so? Hmm... ::He takes one last hard look at the device. After that, he looks at his nearby colleague. Finally he turns towards you.:: Bah, who am I kidding, I have no idea what I'm doing with this thing. ::He sighs.:: Fine, disembark on the back of the ship and walk over to me here.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
    <unit id="=&gt;a22" name="=&gt;a22">
