      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">158</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The likes of you could never comprehend such greatness.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
