        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">138</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'll just mind my own business.&lt;end&gt;</source>
        <target state="new"/>
      </segment>
    </unit>
