        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">156</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Serve junkyard surprise.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q79" name="=&gt;q79">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">158</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You lower the food on the dish below you. ::&lt;end&gt;</source>
        <target state="new" />
