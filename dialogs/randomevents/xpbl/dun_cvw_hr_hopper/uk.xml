      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">170</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::You place the salad on the dish. This should be something hoppers adore.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q86" name="=&gt;q86">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">172</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Immediately the hopper leaps into the action, devouring the salad with great swiftness. As if it was never there to begin with.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a87" name="=&gt;a87">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">174</mda:meta>
      </mda:metadata>
