      </segment>
    </unit>
    <unit id="=&gt;q71" name="=&gt;q71">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">142</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The hopper easily sips the milk. It's a slow process but eventually, the milk's all gone from the dish.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a72" name="=&gt;a72">
