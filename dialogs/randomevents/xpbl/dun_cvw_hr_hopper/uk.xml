        <mda:meta type="pos_id">146</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::Your well preserved coffee lands on the dirty dish below.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q74" name="=&gt;q74">
