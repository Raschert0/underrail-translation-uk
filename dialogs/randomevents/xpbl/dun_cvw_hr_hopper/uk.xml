        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">148</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>::The hopper is initially confused with it, slowly walking half circles back and forth around it. After a long while, the hopper lowers its mouth inside the coffee and drinks it all in one go.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a75" name="=&gt;a75">
