        <source>Alright. ::Leave.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;a29" name="=&gt;a29">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">58</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>How did you make it?&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q30" name="=&gt;q30">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">60</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>A-ha! That's a secret! Sorry friend, I can't let you know about it. Otherwise, you could put me out of the business! ::He laughs.::&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
