    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Down with the Oligarchs!&lt;end&gt;</source>
        <target state="needs-translation">Геть з олігархами!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We have rights - we're human beings!&lt;end&gt;</source>
        <target state="needs-translation">Ми маємо права - ми люди!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>No one gives a licked pipe about us zoners!&lt;end&gt;</source>
        <target state="needs-translation">Нікому немає діла до нас, зонерів!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Drop off, Praetorians! And Coretech fat rats! And JKK crooks!&lt;end&gt;</source>
        <target state="needs-translation">Геть з преторіанцями! І з товстими щурами з Coretech! І з шахраями з JKK!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>We're starving!&lt;end&gt;</source>
        <target state="needs-translation">Ми голодуємо!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>The fat rats are stuffing themselves! What about us?&lt;end&gt;</source>
        <target state="needs-translation">Товсті щури набивають собі черева! А як же ми?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Is everyone derailed in this cursed city?&lt;end&gt;</source>
        <target state="needs-translation">Чи всі збожеволіли в цьому проклятому місті?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Burn the fat rats!&lt;end&gt;</source>
        <target state="needs-translation">Спаліть товстих щурів!&lt;end&gt;</target>
      </segment>
    </unit>
