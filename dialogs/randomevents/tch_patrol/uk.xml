    <unit id="=&gt;q2" name="=&gt;q2">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Tchort is evolution.&lt;end&gt;</source>
        <target state="needs-translation">Тчорт – це еволюція.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q3" name="=&gt;q3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>The Faceless are nothing compared to the Preservation Forces. Proven!&lt;end&gt;</source>
        <target state="needs-translation">Безликі ніщо порівняно з Силами Збереження. Доведено!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>::Performs a Tchortist salute.::&lt;end&gt;</source>
        <target state="needs-translation">::Виконує тчортистське вітання.::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Thank you for returning the Reaching Man, $(#brother/sister).&lt;end&gt;</source>
        <target state="needs-translation">Дякуємо за повернення Людини, що Досягає, $(#брате/сестро).&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Join Preservation - if you have the guts.&lt;end&gt;</source>
        <target state="needs-translation">Приєднайся до Збереження – якщо в тебе вистачить сміливості.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Are there any news from Core City?&lt;end&gt;</source>
        <target state="needs-translation">Чи є якісь новини з Центрального Міста?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q8" name="=&gt;q8">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>The Lunatics are everywhere! As if something is drawing them toward the Institute.&lt;end&gt;</source>
        <target state="needs-translation">Божевільні всюди! Ніби щось притягує їх до Інституту.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q9" name="=&gt;q9">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">18</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Adapt and overcome.&lt;end&gt;</source>
        <target state="needs-translation">Адаптуйся та перемагай.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q10" name="=&gt;q10">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>With Tchort's guidance we *will* walk the Surface!&lt;end&gt;</source>
        <target state="needs-translation">З керівництвом Тчорта ми *обов'язково* вийдемо на Поверхню!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q11" name="=&gt;q11">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">22</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>&lt;end&gt;</source>
        <target state="needs-translation">&lt;end&gt;</target>
