    <unit id="=&gt;q12" name="=&gt;q12">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>We are from the Institute of Tchort, traveler.&lt;end&gt;</source>
        <target state="needs-translation">Ми з Інституту Тчорта, мандрівнику.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q13" name="=&gt;q13">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">26</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>May I help you, traveler?&lt;end&gt;</source>
        <target state="needs-translation">Чи можу я вам допомогти, мандрівнику?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q14" name="=&gt;q14">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">28</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>All Lunatics shall be culled on sight.&lt;end&gt;</source>
        <target state="needs-translation">Усіх Божевільних буде знищено на місці.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q15" name="=&gt;q15">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">30</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>Tchort guide you, traveler.&lt;end&gt;</source>
        <target state="needs-translation">Нехай Тчорт веде тебе, мандрівнику.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q16" name="=&gt;q16">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">32</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>If you find yourself in Core City, seek our missionaries. There is much you can learn.&lt;end&gt;</source>
        <target state="needs-translation">Якщо ти опинишся в Центральному Місті, шукай наших місіонерів. Там ти зможеш багато чого дізнатися.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q17" name="=&gt;q17">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">34</mda:meta>
      </mda:metadata>
      <segment state="translated" xml:space="preserve">
        <source>No reason to fear us, traveler. We wish you no harm.&lt;end&gt;</source>
        <target state="needs-translation">Немає причин боятися нас, мандрівнику. Ми не бажаємо тобі зла.&lt;end&gt;</target>
      </segment>
    </unit>
