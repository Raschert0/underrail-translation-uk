        <source>Wait, I'm your ally!&lt;end&gt;</source>
        <target state="needs-translation">Зачекай, я твій союзник!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a12" name="=&gt;a12">
      <mda:metadata>
