        <mda:meta type="pos_id">20</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Why are you doing all of this?&lt;end&gt;</source>
        <target state="needs-translation">Навіщо ти все це робиш?&lt;end&gt;</target>
      </segment>
    </unit>
