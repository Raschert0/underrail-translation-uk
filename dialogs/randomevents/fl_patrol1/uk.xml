        <mda:meta type="pos_id">24</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What if I don't want to leave?&lt;end&gt;</source>
        <target state="needs-translation">Що, якщо я не хочу йти?&lt;end&gt;</target>
      </segment>
    </unit>
