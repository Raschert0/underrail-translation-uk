    <unit id="=&gt;a3" name="=&gt;a3">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What is going on here?&lt;end&gt;</source>
        <target state="needs-translation">Що тут відбувається?&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q4" name="=&gt;q4">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Leave... or suffer the consequences.&lt;end&gt;</source>
        <target state="needs-translation">Залиш... або пошкодуєш.&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a5" name="=&gt;a5">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>No one tells me what to do, freak! ::Attack!::&lt;end&gt;</source>
        <target state="needs-translation">Мені ніхто не каже, що робити, покидько! ::Атака!::&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;a6" name="=&gt;a6">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">12</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>I'm leaving, I'm leaving!&lt;end&gt;</source>
        <target state="needs-translation">Я йду, я йду!&lt;end&gt;</target>
      </segment>
    </unit>
    <unit id="=&gt;q7" name="=&gt;q7">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">14</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>You will not get another warning...

::The Faceless ends the conversation by reaching underneath his mask once again.::&lt;end&gt;</source>
        <target state="needs-translation">Ти не отримаєш більше жодного попередження...

::Безликий закінчує розмову, знову простягаючи руку під маску.::&lt;end&gt;</target>
      </segment>
    </unit>
