        <mda:meta type="pos_id">16</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Mind if I ask you a few questions?&lt;end&gt;</source>
        <target state="needs-translation">Дозвольте мені задати вам кілька питань?&lt;end&gt;</target>
      </segment>
    </unit>
