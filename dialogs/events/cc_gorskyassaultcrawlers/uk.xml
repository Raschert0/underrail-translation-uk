        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Gorsky!? I know that name! That's the pipeworker who killed Helaku! He killed Helaku!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q5" name="=&gt;q5">
