        <mda:meta type="pos_id">10</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>What are you doing, idiots! They're just standing over there, kill them! Kill them all!&lt;end&gt;</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="=&gt;q6" name="=&gt;q6">
