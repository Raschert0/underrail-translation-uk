  <file id="knowledge\combatstattooltips.txt" original="knowledge\combatstattooltips.txt">
    <unit id="::Health" name="::Health">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">1</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Shows current and maximum health points. When your current health points reach zero, you die.</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="::HealingEffectiveness" name="::HealingEffectiveness">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Shows the number by which any incoming healing will be modified.</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="::Shield" name="::Shield">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">3</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Shows current and maximum shield points. Whenever you're hit, the shield will absorb certain amount of damage depending on the impact speed of the attack as long as you have shield points left. Shield will also slowly deplete on their own while turned on.</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="::Psi" name="::Psi">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">4</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Shows current and maximum psi points, as well as psi regeneration per turn. Psi is used to invoke psionic abilities.</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="::PsiReserve" name="::PsiReserve">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">5</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Shows current and maximum psi point reserves. These points are used to naturally regenerate regular psi points over time.</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="::Dodge" name="::Dodge">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">6</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Increases your chance to avoid melee attacks.</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="::Evasion" name="::Evasion">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">7</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Increases your chance to avoid ranged weapon attacks and also decreases the damage taken from area of effect attacks.</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="::Fortitude" name="::Fortitude">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">8</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Increases the chance to resist some negative status effects, such as stun and incapacitation, caused by direct physical trauma. Also increases poison resistance.</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="::Resolve" name="::Resolve">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">9</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Increases the chance to resist some negative status effects, such as stun and incapacitation, caused by mental stress and also reduces damage or duration of certain psionic attacks that target the mind directly.</source>
        <target state="new" />
      </segment>
    </unit>
