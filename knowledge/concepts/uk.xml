  <file id="knowledge\concepts.txt" original="knowledge\concepts.txt">
    <unit id="::MovementPoints" name="::MovementPoints">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">1</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>These points can only be used for movement.</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="::ActionPoints" name="::ActionPoints">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">2</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>These points can be used for performing actions or for movement if there are no movement points left. You can carry over up to {0} unspent action points to the next turn.</source>
        <target state="new" />
      </segment>
    </unit>
    <unit id="::Innervate" name="::Innervate">
      <mda:metadata>
        <mda:meta type="version">1</mda:meta>
        <mda:meta type="pos_id">3</mda:meta>
      </mda:metadata>
      <segment state="translated">
        <source>Applies the changes made to the psi ability selection. This will instantly drain all of your psi points and reserves.

This can only be done out of combat.</source>
        <target state="new" />
      </segment>
    </unit>
